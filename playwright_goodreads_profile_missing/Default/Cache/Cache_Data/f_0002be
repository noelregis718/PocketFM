"},"book":{"__ref":"Book:kca://book/amzn1.gr.book.v1.LW-Xlgu90NUth3S-XdPGEA","id":"kca://book/amzn1.gr.book.v1.LW-Xlgu90NUth3S-XdPGEA"},"shelf":{"__typename":"Shelf","name":"read","displayName":"Read","editable":false,"default":true,"actionType":"add_to_read","sortOrder":2,"webUrl":"https://www.goodreads.com/review/list/7742509?shelf=read"},"taggings":[{"__typename":"Tagging","tag":{"__typename":"Tag","name":"arc-review-copy","webUrl":"https://www.goodreads.com/review/list/7742509?shelf=arc-review-copy"}},{"__typename":"Tagging","tag":{"__typename":"Tag","name":"4-stars","webUrl":"https://www.goodreads.com/review/list/7742509?shelf=4-stars"}}],"webUrl":"https://www.goodreads.com/review/show/1996658450"},"Review:kca://review:goodreads/amzn1.gr.review:goodreads.v1.W50ThBlvZERFIpVGdQQrgw":{"__typename":"Review","id":"kca://review:goodreads/amzn1.gr.review:goodreads.v1.W50ThBlvZERFIpVGdQQrgw","creator":{"__ref":"User:7742509"},"recommendFor":null,"updatedAt":1728945968048,"createdAt":1494528816337,"spoilerStatus":false,"lastRevisionAt":1728945967531,"text":"\u003ci\u003eDestining is bringing the stones and mates together. She will not be denied.\u003c/i\u003e \u003cbr\u003e\u003cbr\u003e\u003cb\u003eLure of the Wolf\u003c/b\u003e is book two, but can be read as a stand-a-lone. It was a wonderful, delightful, and sweet read in the \u003ci\u003eAloha Shifters: Jewels of the Heart series.\u003c/i\u003e \u003cbr\u003e\u003cbr\u003eLure of the Wolf is an exciting, delicious, and satisfying read. The action and suspense kept me on the edge of my set. The characters are interesting and the story is well told. I just love each of the five “brothers in arms”. These brothers are retired military men that have formed their own unique pack, clan, group. Each one is unique and nothing is off limits except falling in love with humans. \u003cbr\u003e\u003cbr\u003eBoone is adorable and Nina is so kindhearted. They are just perfect for each other. You can see their connection throughout and how well they work together. The story is captivating and intriguing. Just trying to figure out what will happen next is exciting. \u003cbr\u003e\u003cbr\u003eThis is such a fun series. You can’t go wrong with Anna Lowe and her shifter stories. \u003cbr\u003e\u003cbr\u003e\u003cb\u003eRated: 4 Stars\u003c/b\u003e\u003cbr\u003e\u003cbr\u003e\u003cb\u003e*Disclaimer:\u003c/b\u003e \u003ci\u003eI received a complimentary copy provided by Anna Lowe with the sole purpose of an honest review. All thoughts, comments and ratings are my own.\u003c/i\u003e\u003cbr\u003e\u003cbr\u003e\u003ca href=\"https://angelsbooknook.com/\" rel=\"nofollow noopener\"\u003e\n  \u003cimg src=\"https://i.gr-assets.com/images/S/compressed.photo.goodreads.com/hostedimages/1698286754i/34859958.jpg\" width=\"400\" height=\"100\" alt=\"angelsgp-seethisreview-blure\" class=\"gr-hostedUserImg\" loading=\"lazy\"\u003e\n\u003c/a\u003e","rating":4,"preReleaseBookSource":null,"shelving":{"__ref":"Shelving:{\"creator\":{\"id\":\"kca://profile:goodreads/APN4I2MPBK1HF\"},\"book\":{\"id\":\"kca://book/amzn1.gr.book.v1.LW-Xlgu90NUth3S-XdPGEA\"}}"},"likeCount":8,"viewerHasLiked":null,"commentCount":0},"User:107902907":{"__typename":"User","legacyId":107902907,"imageUrlSquare":"https://i.gr-assets.com/images/S/compressed.photo.goodreads.com/users/1577837563i/107902907._UX200_CR0,0,200,200_.jpg","isAuthor":false,"viewerRelationshipStatus":null,"followersCount":17,"textReviewsCount":94,"name":"Malá Knihomolka","webUrl":"https://www.goodreads.com/user/show/107902907-mal-knihomolka","contributor":null,"id":107902907},"User:kca://profile:goodreads/A354X94DC8KYN0":{"__typename":"User","id":"kca://profile:goodreads/A354X94DC8KYN0"},"Book:kca://book/amzn1.gr.book.v3.Z-8HeFWcd0aBEDZJ":{"__typename":"Book","id":"kca://book/amzn1.gr.book.v3.Z-8HeFWcd0aBEDZJ"},"Shelving:{\"creator\":{\"id\":\"kca://profile:goodreads/A354X94DC8KYN0\"},\"book\":{\"id\":\"kca://book/amzn1.gr.book.v3.Z-8HeFWcd0aBEDZJ\"}}":{"__typename":"S