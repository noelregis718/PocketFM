03eI had one quibble only. I repeat, MINOR quibble. Though we were given many explanations for Lex making her choice of love-interest, I seemed to want something more to explain why she didn't choose the other guy...yet. I put this down to my impatience in general.\u003cbr /\u003e\u003cbr /\u003eGet Emerge and you are assured of a professional copy, a great story, an addiction to Melissa A. Craven's writing, and frustration at the wait before book two is out! Get it now!","rating":5,"preReleaseBookSource":null,"shelving":{"__ref":"Shelving:{\"creator\":{\"id\":\"kca://profile:goodreads/A1RE5918297D0Z\"},\"book\":{\"id\":\"kca://book/amzn1.gr.book.v1.G3rRAsyyTxfuwJll0Wx1fQ\"}}"},"likeCount":5,"viewerHasLiked":null,"commentCount":0},"User:43758460":{"__typename":"User","legacyId":43758460,"imageUrlSquare":"https://i.gr-assets.com/images/S/compressed.photo.goodreads.com/users/1433705743i/43758460.jpg","isAuthor":false,"viewerRelationshipStatus":null,"followersCount":0,"textReviewsCount":1,"name":"Chris Mills","webUrl":"https://www.goodreads.com/user/show/43758460-chris-mills","contributor":null,"id":43758460},"User:kca://profile:goodreads/A3F40VMQ2TSH0K":{"__typename":"User","id":"kca://profile:goodreads/A3F40VMQ2TSH0K"},"Shelving:{\"creator\":{\"id\":\"kca://profile:goodreads/A3F40VMQ2TSH0K\"},\"book\":{\"id\":\"kca://book/amzn1.gr.book.v1.G3rRAsyyTxfuwJll0Wx1fQ\"}}":{"__typename":"Shelving","creator":{"__ref":"User:kca://profile:goodreads/A3F40VMQ2TSH0K","id":"kca://profile:goodreads/A3F40VMQ2TSH0K"},"book":{"__ref":"Book:kca://book/amzn1.gr.book.v1.G3rRAsyyTxfuwJll0Wx1fQ","id":"kca://book/amzn1.gr.book.v1.G3rRAsyyTxfuwJll0Wx1fQ"},"shelf":{"__typename":"Shelf","name":"read","displayName":"Read","editable":false,"default":true,"actionType":"add_to_read","sortOrder":2,"webUrl":"https://www.goodreads.com/review/list/43758460?shelf=read"},"taggings":[],"webUrl":"https://www.goodreads.com/review/show/1304993282"},"Review:kca://review:goodreads/amzn1.gr.review:goodreads.v1