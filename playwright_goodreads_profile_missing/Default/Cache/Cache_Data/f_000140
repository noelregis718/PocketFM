,{"__typename":"Tagging","tag":{"__typename":"Tag","name":"suspense","webUrl":"https://www.goodreads.com/review/list/79952619?shelf=suspense"}}],"webUrl":"https://www.goodreads.com/review/show/6954412219"},"Review:kca://review:goodreads/amzn1.gr.review:goodreads.v1.kWJTYalLZJc4QOiPX1USaQ":{"__typename":"Review","id":"kca://review:goodreads/amzn1.gr.review:goodreads.v1.kWJTYalLZJc4QOiPX1USaQ","creator":{"__ref":"User:79952619"},"recommendFor":null,"updatedAt":1753643574158,"createdAt":1735230368926,"spoilerStatus":false,"lastRevisionAt":1735230480504,"text":"5 stars!! Enjoyed a m/m romance after a long time.. ❤️❤️","rating":5,"preReleaseBookSource":null,"shelving":{"__ref":"Shelving:{\"creator\":{\"id\":\"kca://profile:goodreads/A9ZUHNLAJDC0G\"},\"book\":{\"id\":\"kca://book/amzn1.gr.book.v3.JCB4XHW0oW5d8wQG\"}}"},"likeCount":22,"viewerHasLiked":null,"commentCount":3},"User:116858692":{"__typename":"User","legacyId":116858692,"imageUrlSquare":"https://i.gr-assets.com/images/S/compressed.photo.goodreads.com/users/1649862021i/116858692._UY200_CR0,0,200,200_.jpg","isAuthor":false,"viewerRelationshipStatus":null,"followersCount":62,"textReviewsCount":617,"name":"a_n_i_t_a","webUrl":"https://www.goodreads.com/user/show/116858692-a-n-i-t-a","contributor":null,"id":116858692},"User:kca://profile:goodreads/A18JXVFY9KKMH6":{"__typename":"User","id":"kca://profile:goodreads/A18JXVFY9KKMH6"},"Shelving:{\"creator\":{\"id\":\"kca://profile:goodreads/A18JXVFY9KKMH6\"},\"book\":{\"id\":\"kca://book/amzn1.gr.book.v3.JCB4XHW0oW5d8wQG\"}}":{"__typename":"Shelving","creator":{"__ref":"User:kca://profile:goodreads/A18JXVFY9KKMH6","id":"kca://profile:goodreads/A18JXVFY9KKMH6"},"book":{"__ref":"Book:kca://book/amzn1.gr.book.v3.JCB4XHW0oW5d8wQG","id":"kca://book/amzn1.gr.book.v3.JCB4XHW0oW5d8wQG"},"shelf":{"__typename":"Shelf","name":"read","displayName":"Read","editable":false,"default":true,"actionType":"add_to_read","sortOrder":2,"webUrl":"https://www.goodreads.com/review/list/116858692?shelf=read"},"taggings":[],"webUrl":"https://www.goodreads.com/review/show/8731736136"},"Review:kca://review:goodreads/amzn1.gr.review:goodreads.v1.ISTHeJ7YRwkOjfxViFkLjA":{"__typename":"Review","id":"kca://review:goodreads/amzn1.gr.review:goodreads.v1.ISTHeJ7YRwkOjfxViFkLjA","creator":{"__ref":"User:116858692"},"recommendFor":null,"updatedAt":1783200023440,"createdAt":1783136580255,"spoilerStatus":false,"lastRevisionAt":1783141072798,"text":"• m/m • book 2 • contemp rom • enemies to lovers • \u003cbr /\u003e\u003cbr /\u003eI liked this a lot more than \u003ca href=\"https://www.goodreads.com/review/show/7853619593\" rel=\"nofollow noopener\"\u003ethe first book\u003c/a\u003e in this series! The plot was wildly out there. Two British politicians from opposing political parties end up channeling their inner survivalists when they become stranded and hunted in the Scandinavian wilderness. \u003cbr /\u003e\u003cbr /\u003eConservative Harry. Pomp, entitled, serious, carrying on his family’s work in the political world. Toby from a working class background, doing it for his people. They have never got along, they have opposing views on everything, but now they need to rely on each other and trust each other to survive.\u003cbr /\u003e\u003cbr /\u003eThis is one of those books where you really do need to suspend all disbelief. But I really enjoyed this one! Quite possibly because I had lower expectations since I didn’t really vibe with the first book…? 🤔 \u003cbr /\u003e\u003cbr /\u003eI loved the dynamic between the two MMCs. Toby and Harry had really fun antagonising interactions\u003cbr /\u003e\u003cbr /\u003e\u003cb\u003e\n  \u003ci\u003e\n    \u003cblockquote\u003e\u003cbr /\u003e“Well I finally investigated, and I discovered there actually isn’t a stick stuck up your arse like I always suspected”. \u003cbr /\u003e\u003c/blockquote\u003e\n  \u003c/i\u003e\n\u003c/b\u003e\u003cbr /\u003e\u003cbr /\u003e🤭🤣\u003cbr /\u003e\u003cbr /\u003eBut the slow romance development, them warming up to each other, growing to understand each other and trust each other was done really well I thought. Overall the book was entertaining without being cringe. I loved the banter. I loved the romance. The plot though... I just had to roll with the wildness 😅\u003cbr /\u003e\u003cbr /\u003e4⭐️\u003cbr /\u003e2🌶️","rating":4,"preReleaseBookSource":null,"shelving":{"__ref":"Shelving:{\"creator\":{\"id\":\"kca://profile:goodreads/A18JXVFY9KKMH6\"},\"book\":{\"id\":\"kca://book/amzn1.gr.book.v3.JCB4XHW0oW5d8wQG\"}}"},"likeCount":21,"viewerHasLiked":null,"commentCount":10},"User:119624292":{"__typename":"User","legacyId":119624292,"imageUrlSquare":"https://i.gr-assets.com/images/S/compressed.photo.goodreads.com/users/1642411993i/119624292._UX200_CR0,0,200,200_.jpg","isAuthor":false,"viewerRelationshipStatus":null,"followersCount":111,"textReviewsCount":1079,"name":"Sarah","webUrl":"https://www.goodreads.com/user/show/119624292-sarah","contributor":null,"id":119624292},"User:kca://profile:goodreads/A1XD2KGW5WESVR":{"__typename":"User","id":"kca://profile:goodreads/A1XD2KGW5WESVR"},"Shelving:{\"creator\":{\"id\":\"kca://profile:goodreads/A1XD2KGW5WESVR\"},\"book\":{\"id\":\"kca://book/amzn1.gr.book.v3.JCB4XHW0oW5d8wQG\"}}":{"__typename":"Shelving","creator":{"__ref":"User:kca://profile:goodreads/A1XD2KGW5WESVR","id":"kca://profile:goodreads/A1XD2KGW5WESVR"},"book":{"__ref":"Book:kca://book/amzn1.gr.book.v3.JCB4XHW0oW5d8wQG","id":"kca://book/amzn1.gr.book.v3.JCB4XHW0oW5d8wQG"},"shelf":{"__typename":"Shelf","name":"read","displayName":"Read","editable":false,"default":true,"actionType":"add_to_read","sortOrder":2,"webUrl":"https://www.goodreads.com/review/list/119624292?shelf=read"},"taggings":[{"__typename":"Tagging","tag":{"__typename":"Tag","name":"buddy-read","webUrl":"https://www.goodreads.com/review/list/119624292?shelf=buddy-read"}}],"webUrl":"https://www.goodreads.com/review/show/6745656147"},"Review:kca://review:goodreads/amzn1.gr.review:goodreads.v1.VsAA4gvmYfFcBSxq3S7kjQ":{"__typename":"Review","id":"kca://review:goodreads/amzn1.gr.review:goodreads.v1.VsAA4gvmYfFcBSxq3S7kjQ","creator":{"__ref":"User:119624292"},"recommendFor":null,"updatedAt":1729419754860,"createdAt":1723516433651,"spoilerStatus":false,"lastRevisionAt":1723516439752,"text":"This did not at all turn out like I expected but it was a fun read and I enjoyed the ending the most. I recommend not taking any of it too seriously, maybe go in thinking romantic comedy, tv drama sort of style and try not to get too nit picky about anything. There was a lot more that could have been explored on almost all plot points but overall it was fun and I liked some of Toby’s snarky one-liners, they made me giggle. Book 3 sounds like it could be brilliant or super cheesy - I’m eager to find out. ","rating":4,"preReleaseBookSource":null,"shelving":{"__ref":"Shelving:{\"creator\":{\"id\":\"kca://profile:goodreads/A1XD2KGW5WESVR\"},\"book\":{\"id\":\"kca://book/amzn1.gr.book.v3.JCB4XHW0oW5d8wQG\"}}"},"likeCount":21,"viewerHasLiked":null,"commentCount":10},"User:9205646":{"__typename":"User","legacyId":9205646,"imageUrlSquare":"https://i.gr-assets.com/images/S/compressed.photo.goodreads.com/users/1779828049i/9205646._UX200_CR0,0,200,200_.jpg","isAuthor":false,"viewerRelationshipStatus":null,"followersCount":133,"textReviewsCount":866,"name":"Jamie","webUrl":"https://www.goodreads.com/user/show/9205646-jamie","contributor":null,"id":9205646},"User:kca://profile:goodreads/A1VNW90PG74V35":{"__typename":"User","id":"kca://profile:goodreads/A1VNW90PG74V35"},"Shelving:{\"creator\":{\"id\":\"kca://profile:goodreads/A1VNW90PG74V35\"},\"book\":{\"id\":\"kca://book/amzn1.gr.book.v3.JCB4XHW0oW5d8wQG\"}}":{"__typename":"Shelving","creator":{"__ref":"User:kca://profile:goodreads/A1VNW90PG74V35","id":"kca://profile:goodreads/A1VNW90PG74V35"},"book":{"__ref":"Book:kca://book/amzn1.gr.book.v3.JCB4XHW0oW5d8wQG","id":"kca://book/amzn1.gr.book.v3.JCB4XHW0oW5d8wQG"},"shelf":{"__typename":"Shelf","name":"read","displayName":"Read","editable":false,"default":true,"actionType":"add_to_read","sortOrder":2,"webUrl":"https://www.goodreads.com/review/list/9205646?shelf=read"},"taggings":[],"webUrl":"https://www.goodreads.com/review/show/6749360619"},"Review:kca://review:goodreads/amzn1.gr.review:goodreads.v1.Mrpaw9G-YsIUlbn02zS0mg":{"__typename":"Review","id":"kca://review:goodreads/amzn1.gr.review:goodreads.v1.Mrpaw9G-YsIUlbn02zS0mg","creator":{"__ref":"User:9205646"},"recommendFor":null,"updatedAt":1723879049206,"createdAt":1723511962936,"spoilerStatus":false,"lastRevisionAt":1723511966019,"text":"Overall I really enjoyed this! It was such a fun read!\u003cbr /\u003eYou do have to suspend a lot of disbelief during their wilderness adventure, that didn’t bother me at all though I was having fun reading it so I was willing to overlook a lot. \u003cbr /\u003eA lot of things get wrapped up too quickly in the epilogue- although I think there is some overlap with book 3 so maybe we will get a bit more. \u003cbr /\u003eAlso, this book had a lot of politics. I know, it’s a book about two politicians so some politics is too be expected- but this was a lot, I didn’t expect that much. Tons of page time devoted to the two of them arguing and debating policies. If you’re burned out on hearing about politics you may want to hold off on reading this lol. It was more than I was expecting- but like I said I overall had a fun time reading this. ","rating":4,"preReleaseBookSource":null,"shelving":{"__ref":"Shelving:{\"creator\":{\"id\":\"kca://profile:goodreads/A1VNW90PG74V35\"},\"book\":{\"id\":\"kca://book/amzn1.gr.book.v3.JCB4XHW0oW5d8wQG\"}}"},"likeCount":15,"viewerHasLiked":null,"commentCount":2},"User:49847054":{"__typename":"User","legacyId":49847054,"imageUrlSquare":"https://i.gr-assets.com/images/S/compressed.photo.goodreads.com/users/1452025028i/49847054._UX200_CR0,0,200,200_.jpg","isAuthor":false,"viewerRelationshipStatus":null,"followersCount":113,"textReviewsCount":1719,"name":"Ariana  (mostly offline)","webUrl":"https://www.goodreads.com/user/show/49847054-ariana-mostly-offline","contributor":null,"id":49847054},"User:kca://profile:goodreads/A1IWLAIEFM2SZA":{"__typename":"User","id":"kca://profile:goodreads/A1IWLAIEFM2SZA"},"Shelving:{\"creator\":{\"id\":\"kca://profile:goodreads/A1IWLAIEFM2SZA\"},\"book\":{\"id\":\"kca://book/amzn1.gr.book.v3.JCB4XHW0oW5d8wQG\"}}":{"__typename":"Shelving","creator":{"__ref":"User:kca://profile:goodreads/A1IWLAIEFM2SZA","id":"kca://profile:goodreads/A1IWLAIEFM2SZA"},"book":{"__ref":"Book:kca://book/amzn1.gr.book.v3.JCB4XHW0oW5d8wQG","id":"kca://book/amzn1.gr.book.v3.JCB4XHW0oW5d8wQG"},"shelf":{"__typename":"Shelf","name":"read","displayName":"Read","editable":false,"default":true,"actionType":"add_to_read","sortOrder":2,"webUrl":"https://www.goodreads.com/review/list/49847054?shelf=read"},"taggings":[{"__typename":"Tagging","tag":{"__typename":"Tag","name":"ku","webUrl":"https://www.goodreads.com/review/list/49847054?shelf=ku"}},{"__typename":"Tagging","tag":{"__typename":"Tag","name":"lgbtq","webUrl":"https://www.goodreads.com/review/list/49847054?shelf=lgbtq"}},{"__typename":"Tagging","tag":{"__typename":"Tag","name":"made-me-laugh","webUrl":"https://www.goodreads.com/review/list/49847054?shelf=made-me-laugh"}}],"webUrl":"https://www.goodreads.com/review/show/5809792738"},"Review:kca://review:goodreads/amzn1.gr.review:goodreads.v1.czbsDqwAVB2oN8Pt3K-SAQ":{"__typename":"Review","id":"kca://review:goodreads/amzn1.gr.review:goodreads.v1.czbsDqwAVB2oN8Pt3K-SAQ","creator":{"__ref":"User:49847054"},"recommendFor":null,"updatedAt":1729414536630,"createdAt":1723227215012,"spoilerStatus":false,"lastRevisionAt":1723228179683,"text":"\u003cb\u003e4,5 stars\u003c/b\u003e\u003cbr /\u003e\u003cbr /\u003eI really loved the first book and could not imagine whatsoever how Harry and Toby would become a ‘pair’.\u003cbr /\u003eJax Calder has done a fantastic job here, writing a totally believable arch-enemies to lovers romance.\u003cbr /\u003e\u003cbr /\u003eTbh, the thing I enjoyed most is the absolutely fabulous, very clever and entertaining ‘political’ banter. It’s sarcastic, acerbic, sharp and utterly hilarious. I salute the author for her research into how British MPs talk in the House of Commons and making those verbal battles so delightfully humorous and compelling.\u003cbr /\u003eI think knowing a little bit about the British Parliament might help to understand the vibe, but a lot of explanation is given for those who have not come across it. \u003cbr /\u003e\u003cbr /\u003eI also loved how the animosity between Harry and Toby gradually melts away, as they get to know each other better and then more intimately. So well done! \u003cbr /\u003eAnd all the dilemmas these two have to face!\u003cbr /\u003e\u003cbr /\u003eYou should know though, and the author acknowledged this in her recent newsletter, that you can’t take the plot too seriously. This is NOT a bible for ‘How to Survive in the Wild” but a romantic comedy, and it should be read as such, refraining from nit-picking the ‘reality’ aspect.\u003cbr /\u003e\u003cbr /\u003eAnd, not to forget, I was totally thrown by two major plot twists, the punchier one happening in the last ten percent. No way, could I have foreseen that! \u003cbr /\u003e\u003cbr /\u003eIf I wanted to note one niggle it was the ‘grand gesture’ towards the end of the book. Like all of them (not a fan!), it made me clench my teeth a little, simply because out of all unlikely things that are plot-related, this was the most unlikely, imo. \u003cbr /\u003e\u003cbr /\u003eSaying that – this is a fabulous, funny and lovely romance I thoroughly enjoyed.\u003cbr /\u003e\u003cbr /\u003e","rating":5,"preReleaseBookSource":null,"shelving":{"__ref":"Shelving:{\"creator\":{\"id\":\"kca://profile:goodreads/A1IWLAIEFM2SZA\"},\"book\":{\"id\":\"kca://book/amzn1.gr.book.v3.JCB4XHW0oW5d8wQG\"}}"},"likeCount":15,"viewerHasLiked":null,"commentCount":3},"User:65110541":{"__typename":"User","legacyId":65110541,"imageUrlSquare":"https://i.gr-assets.com/images/S/compressed.photo.goodreads.com/users/1619896654i/65110541._UY200_CR25,0,200,200_.jpg","isAuthor":false,"viewerRelationshipStatus":null,"followersCount":178,"textReviewsCount":705,"name":"Nelly S.","webUrl":"https://www.goodreads.com/user/show/65110541-nelly-s","contributor":null,"id":65110541},"User:kca://profile:goodreads/A2MYTFDHHK32TD":{"__typename":"User","id":"kca://profile:goodreads/A2MYTFDHHK32TD"},"Shelving:{\"creator\":{\"id\":\"kca://profile:goodreads/A2MYTFDHHK32TD\"},\"book\":{\"id\":\"kca://book/amzn1.gr.book.v3.JCB4XHW0oW5d8wQG\"}}":{"__typename":"Shelving","creator":{"__ref":"User:kca://profile:goodreads/A2MYTFDHHK32TD","id":"kca://profile:goodreads/A2MYTFDHHK32TD"},"book":{"__ref":"Book:kca://book/amzn1.gr.book.v3.JCB4XHW0oW5d8wQG","id":"kca://book/amzn1.gr.book.v3.JCB4XHW0oW5d8wQG"},"shelf":{"__typename":"Shelf","name":"read","displayName":"Read","editable":false,"default":true,"actionType":"add_to_read","sortOrder":2,"webUrl":"https://www.goodreads.com/review/list/65110541?shelf=read"},"taggings":[{"__typename":"Tagging","tag":{"__typename":"Tag","name":"bingeable-series","webUrl":"https://www.goodreads.com/review/list/65110541?shelf=bingeable-series"}},{"__typename":"Tagging","tag":{"__typename":"Tag","name":"class-difference","webUrl":"https://www.goodreads.com/review/list/65110541?shelf=class-difference"}},{"__typename":"Tagging","tag":{"__typename":"Tag","name":"close-proximity","webUrl":"https://www.goodreads.com/review/list/65110541?shelf=close-proximity"}},{"__typename":"Tagging","tag":{"__typename":"Tag","name":"funny-witty","webUrl":"https://www.goodreads.com/review/list/65110541?shelf=funny-witty"}},{"__typename":"Tagging","tag":{"__typename":"Tag","name":"enemies-to-lovers","webUrl":"https://www.goodreads.com/review/list/65110541?shelf=enemies-to-lovers"}},{"__typename":"Tagging","tag":{"__typename":"Tag","name":"sweet-cute","webUrl":"https://www.goodreads.com/review/list/65110541?shelf=sweet-cute"}}],"webUrl":"https://www.goodreads.com/review/show/6008236655"},"Review:kca://review:goodreads/amzn1.gr.review:goodreads.v1.znDsYs-ap1TJyAGQDWgB8g":{"__typename":"Review","id":"kca://review:goodreads/amzn1.gr.review:goodreads.v1.znDsYs-ap1TJyAGQDWgB8g","creator":{"__ref":"User:65110541"},"recommendFor":null,"updatedAt":1723849232831,"createdAt":1723460768261,"spoilerStatus":false,"lastRevisionAt":1723461358210,"text":"This was such a blast!!!\u003cbr /\u003e\u003cbr /\u003e\u003ci\u003e\n  \u003cb\u003e”Harry and I are kissing. Again. I don’t like to give the Conservatives credit for anything, but it appears they really know how to kiss. It must be something to do with the fact their tongues get so much exercise twisting words all the time, which makes them extremely dexterous for kissing.”\u003c/b\u003e\n\u003c/i\u003e\u003cbr /\u003e\u003cbr /\u003e\u003cbr /\u003e\u003ci\u003e\n  \u003cb\u003e”Somehow, despite the precariousness of so much out here, Harry’s making me feel the one thing I haven’t truly felt since my mother died. \u003cbr /\u003eSafe.”\u003c/b\u003e\n\u003c/i\u003e\u003cbr /\u003e\u003cbr /\u003e\u003cbr /\u003e\u003ci\u003e\n  \u003cb\u003e”When I remember this night in the future, I know it won’t be the northern lights I remember. It’ll be Toby‘s face. His beautiful face turned up towards the sky, the lights reflected in his eyes.”\u003c/b\u003e\n\u003c/i\u003e\u003cbr /\u003e\u003cbr /\u003e\u003cbr /\u003e\u003ci\u003e\n  \u003cb\u003e”He knows me better than anyone has ever known me. \u003cbr /\u003eI stumble when I realize this, and Harry’s hand immediately reaches out to stabilize me. \u003cbr /\u003eAll my deep, dark crevasses no one has ever seen, Harry has seen them all. He’s seen me hungry, he’s seen me tired, he’s seen me scared, he’s seen me hurt. \u003cbr /\u003eAnd I know Harry back the same way.”\u003c/b\u003e\n\u003c/i\u003e\u003cbr /\u003e\u003cbr /\u003e✔️Aristocrat vs commoner\u003cbr /\u003e✔️Political opponents \u003cbr /\u003e✔️Hate to love \u003cbr /\u003e✔️Rom-com suspense \u003cbr /\u003e✔️Forced proximity\u003cbr /\u003e✔️Trapped in the Scandinavian wilderness \u003cbr /\u003e✔️British humor and witty banter\u003cbr /\u003e","rating":4,"preReleaseBookSource":null,"shelving":{"__ref":"Shelving:{\"creator\":{\"id\":\"kca://profile:goodreads/A2MYTFDHHK32TD\"},\"book\":{\"id\":\"kca://book/amzn1.gr.book.v3.JCB4XHW0oW5d8wQG\"}}"},"likeCount":13,"viewerHasLiked":null,"commentCount":6},"User:48346320":{"__typename":"User","legacyId":48346320,"imageUrlSquare":"https://i.gr-assets.com/images/S/compressed.photo.goodreads.com/users/1767909230i/48346320._UX200_CR0,0,200,200_.jpg","isAuthor":false,"viewerRelationshipStatus":null,"followersCount":70,"textReviewsCount":1174,"name":"Mir","webUrl":"https://www.goodreads.com/user/show/48346320-mir","contributor":null,"id":48346320},"User:kca://profile:goodreads/A14YUISZCWE42M":{"__typename":"User","id":"kca://profile:goodreads/A14YUISZCWE42M"},"Shelving:{\"creator\":{\"id\":\"kca://profile:goodreads/A14YUISZCWE42M\"},\"book\":{\"id\":\"kca://book/amzn1.gr.book.v3.JCB4XHW0oW5d8wQG\"}}":{"__typename":"Shelving","creator":{"__ref":"User:kca://profile:goodreads/A14YUISZCWE42M","id":"kca://profile:goodreads/A14YUISZCWE42M"},"book":{"__ref":"Book:kca://book/amzn1.gr.book.v3.JCB4XHW0oW5d8wQG","id":"kca://book/amzn1.gr.book.v3.JCB4XHW0oW5d8wQG"},"shelf":{"__typename":"Shelf","name":"read","displayName":"Read","editable":false,"default":true,"actionType":"add_to_read","sortOrder":2,"webUrl":"https://www.goodreads.com/review/list/48346320?shelf=read"},"taggings":[],"webUrl":"https://www.goodreads.com/review/show/6730775044"},"Review:kca://review:goodreads/amzn1.gr.review:goodreads.v1.HpiOWEFrxVsQw_5A9hNeYQ":{"__typename":"Review","id":"kca://review:goodreads/amzn1.gr.review:goodreads.v1.HpiOWEFrxVsQw_5A9hNeYQ","creator":{"__ref":"User:48346320"},"recommendFor":null,"updatedAt":1729414541486,"crea