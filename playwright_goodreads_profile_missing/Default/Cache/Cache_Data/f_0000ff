n1.gr.book.v3.E_bVqUiLxFQvwsNh\"}}"},"likeCount":1,"viewerHasLiked":null,"commentCount":0},"User:94794877":{"__typename":"User","legacyId":94794877,"imageUrlSquare":"https://i.gr-assets.com/images/S/compressed.photo.goodreads.com/users/1785641333i/94794877._UX200_CR0,0,200,200_.jpg","isAuthor":false,"viewerRelationshipStatus":null,"followersCount":34,"textReviewsCount":1031,"name":"Shades N Pages","webUrl":"https://www.goodreads.com/user/show/94794877-shades-n-pages","contributor":null,"id":94794877},"User:kca://profile:goodreads/A36OEYCJ0WJ1C9":{"__typename":"User","id":"kca://profile:goodreads/A36OEYCJ0WJ1C9"},"Shelving:{\"creator\":{\"id\":\"kca://profile:goodreads/A36OEYCJ0WJ1C9\"},\"book\":{\"id\":\"kca://book/amzn1.gr.book.v3.E_bVqUiLxFQvwsNh\"}}":{"__typename":"Shelving","creator":{"__ref":"User:kca://profile:goodreads/A36OEYCJ0WJ1C9","id":"kca://profile:goodreads/A36OEYCJ0WJ1C9"},"book":{"__ref":"Book:kca://book/amzn1.gr.book.v3.E_bVqUiLxFQvwsNh","id":"kca://book/amzn1.gr.book.v3.E_bVqUiLxFQvwsNh"},"shelf":{"__typename":"Shelf","name":"read","displayName":"Read","editable":false,"default":true,"actionType":"add_to_read","sortOrder":2,"webUrl":"https://www.goodreads.com/review/list/94794877?shelf=read"},"taggings":[],"webUrl":"https://www.goodreads.com/review/show/3233473357"},"Review:kca://review:goodreads/amzn1.gr.review:goodreads.v1.lYX8Gnu5nEfTKhVXyKz1Hg":{"__typename":"Review","id":"kca://review:goodreads/amzn1.gr.review:goodreads.v1.lYX8Gnu5nEfTKhVXyKz1Hg","creator":{"__ref":"User:94794877"},"recommendFor":null,"updatedAt":1618715832287,"createdAt":1584384097703,"spoilerStatus":false,"lastRevisionAt":1584542511461,"text":"Cheated out of knowing her true destiny, Dr Amani Giles is clueless of the power she inherited and the reason for the deep yearning she feels for Aleksandr Morozov. Aleksandr is the CEO of his own corporation and also moonlights as the Vampire King. Alek was told that finding his true mate was a myth until he laid eyes on Amani, the woman destined to stand beside him as his queen. \u003cbr /\u003e\u003cbr /\u003eAs a lover of all things paranormal, I was drawn to this book. Knowing a Vampire and Witch were true mates sold me.The author wasted no time developing the romance between Amani and Alek and I truly liked them together. They didn’t tolerate deception and took control of their lives without question. This story was very fast paced. It packed heat, betrayal and low suspense. \u003cbr /\u003e\u003cbr /\u003eWith that being said, I wanted this book longer.Ten chapters was not enough time to adequately tell a story of a woman who had no idea of the paranormal world, her ancestry or her role in it. My biggest issue was that this book lacked major detail that would have made it a more complete story. We never see her accepting herself as a witch, we don’t see her coming into her power and we don’t see an important scene with her grandmother. These scenes were significant to this story as a whole and should have been fleshed out. If this was a short story, I would have felt comfortable with the size of this book but for the beginning of a trilogy, the author was not detailed enough in her world building and we weren’t privy to a complete backstory.\u003cbr /\u003e\u003cbr /\u003eOverall, I did enjoy reading and I will continue with the trilogy. Moving forward, I hope the author is more focused on details and character development.\u003cbr /\u003e\u003cbr /\u003e\u003cbr /\u003e\u003cbr /\u003e\u003cbr /\u003e\u003cbr /\u003e\u003cbr /\u003e\u003cbr /\u003e\u003cbr /\u003e \u003cbr /\u003e\u003cbr /\u003e\u003cbr /\u003e\u003cbr /\u003e\u003cbr /\u003e\u003cbr /\u003e\u003cbr /\u003e\u003cbr /\u003e\u003cbr /\u003e\u003cbr /\u003e\u003cbr /\u003e\u003cbr /\u003e","rating":3,"preReleaseBookSource":null,"shelving":{"__ref":"Shelving:{\"creator\":{\"id\":\"kca://profile:goodreads/A36OEYCJ0WJ1C9\"},\"book\":{\"id\":\"kca://book/amzn1.gr.book.v3.E_bVqUiLxFQvwsNh\"}}"},"likeCount":1,"viewerHasLiked":nul