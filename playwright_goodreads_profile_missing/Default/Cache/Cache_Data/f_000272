/book/amzn1.gr.book.v3.3D_4JwauvDI8GDpO","id":"kca://book/amzn1.gr.book.v3.3D_4JwauvDI8GDpO"},"shelf":{"__typename":"Shelf","name":"read","displayName":"Read","editable":false,"default":true,"actionType":"add_to_read","sortOrder":2,"webUrl":"https://www.goodreads.com/review/list/26177107?shelf=read"},"taggings":[{"__typename":"Tagging","tag":{"__typename":"Tag","name":"sue","webUrl":"https://www.goodreads.com/review/list/26177107?shelf=sue"}}],"webUrl":"https://www.goodreads.com/review/show/3282361426"},"Review:kca://review:goodreads/amzn1.gr.review:goodreads.v1.AXMn7h7PyiazTUpv8PMwew":{"__typename":"Review","id":"kca://review:goodreads/amzn1.gr.review:goodreads.v1.AXMn7h7PyiazTUpv8PMwew","creator":{"__ref":"User:26177107"},"recommendFor":null,"updatedAt":1666322007636,"createdAt":1586967153290,"spoilerStatus":false,"lastRevisionAt":1586967281607,"text":"\u003ci\u003eA \u003ca href=\"http:joyfullyjay.com\" rel=\"nofollow noopener\"\u003eJoyfully Jay\u003c/a\u003e review. \u003cbr /\u003e\u003cbr /\u003e\u003cb\u003e 5 stars\u003c/b\u003e\u003c/i\u003e\u003cbr /\u003e\u003cbr /\u003eThis well-paced fantasy is engaging and entertaining from page one. Hamish and Darshan are wonderfully rendered characters and really the strong point of the book. Both men are fully developed and vibrantly relatable. Hamish especially tugs at the heartstrings. His loneliness is painful to read and he’s been forced to live half a life, which I found heartbreaking. I found it impossible not to champion their love story and, despite the fact they only know one another a few weeks, their romance reads as believable. I will say the phrase “his lover” is used far too often, to the point of annoyance, but I suppose in the grand scheme that complaint is a minor one.\u003cbr /\u003e\u003cbr /\u003eOne of the best parts of To Target the Heart is the world building. It’s expansive and thorough without being overwhelming. The author does an excellent job of naturally blending information about the world around Hamish and Darshan. I never felt bogged down by info dumping or overly complex information that lacked purpose. Tirglas and Uydea are well described and I felt like there was just the right amount of world building to make these places feel real.\u003cbr /\u003e\u003cbr /\u003e\u003cb\u003eRead Sue’s review in its entirety \u003ca href=\"https://joyfullyjay.com/2020/04/review-to-target-the-heart-by-aldrea-alien/\" rel=\"nofollow noopener\"\u003ehere\u003c/a\u003e.\u003c/b\u003e\u003cbr /\u003e","rating":5,"preReleaseBookSource":null,"shelving":{"__ref":"Shelving:{\"creator\":{\"id\":\"kca://profile:goodreads/A2AEVCDO5N1B9J\"},\"book\":{\"id\":\"kca://book/amzn1.gr.book.v3.3D_4JwauvDI8GDpO\"}}"},"likeCount":6,"viewerHasLiked":null,"commentCount":0},"User:29654860":{"__typename":"User","legacyId":29654860,"imageUrlSquare":"https://i.gr-assets.com/images/S/compressed.photo.goodreads.com/users/1727637441i/29654860._UX200_CR0,0,200,200_.jpg","isAuthor":false,"viewerRelationshipStatus":null,"followersCount":31,"textReviewsCount":1076,"name":"T.A. Burke","webUrl":"https://www.goodreads.com/user/show/29654860-t-a-burke","contributor":null,"id":29654860},"User:kca://profile:goodreads/AT4160H6R2454":{"__typename":"User","id":"kca://profile:goodreads/AT4160H6R2454"},"Shelving:{\"creator\":{\"id\":\"kca://profile:goodreads/AT4160H6R2454\"},\"book\":{\"id\":\"kca://book/amzn1.gr.book.v3.3D_4JwauvDI8GDpO\"}}":{"__typename":"Shelving","creator":{"__ref":"User:kca://profile:goodreads/AT4160H6R2454","id":"kca://profile:goodreads/AT4160H6R2454"},"book":{"__ref":"Book:kca://book/amzn1.gr.book.v3.3D_4JwauvDI8GDpO","id":"kca://book/amzn1.gr.book.v3.3D_4JwauvDI8GDpO"},"shelf":{"__typename":"Shelf","name":"read","displayName":"Read","editable":false,"default":true,"actionType":"add_to_read","sortOrder":2,"webUrl":"https://www.goodreads.com/review/list/29654860?shelf=read"},"taggings":[],"webUrl":"https://www.goodreads.com/review/show/4352648932"},"Review:kca://review:goodreads