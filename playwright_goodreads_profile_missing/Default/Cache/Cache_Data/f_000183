ety be damned.\u003cbr /\u003e\u003cbr /\u003eKudos to Laura Greenwood and I can't wait until book #8.","rating":5,"preReleaseBookSource":null,"shelving":{"__ref":"Shelving:{\"creator\":{\"id\":\"kca://profile:goodreads/AFXPCMDQ5AXNS\"},\"book\":{\"id\":\"kca://book/amzn1.gr.book.v3.k75t-UiRTUjslITy\"}}"},"likeCount":1,"viewerHasLiked":null,"commentCount":0},"User:18379101":{"__typename":"User","legacyId":18379101,"imageUrlSquare":"https://i.gr-assets.com/images/S/compressed.photo.goodreads.com/users/1363317882i/18379101.jpg","isAuthor":false,"viewerRelationshipStatus":null,"followersCount":4,"textReviewsCount":1516,"name":"Lisa","webUrl":"https://www.goodreads.com/user/show/18379101-lisa","contributor":null,"id":18379101},"User:kca://profile:goodreads/A36VM425M52BHK":{"__typename":"User","id":"kca://profile:goodreads/A36VM425M52BHK"},"Shelving:{\"creator\":{\"id\":\"kca://profile:goodreads/A36VM425M52BHK\"},\"book\":{\"id\":\"kca://book/amzn1.gr.book.v3.k75t-UiRTUjslITy\"}}":{"__typename":"Shelving","creator":{"__ref":"User:kca://profile:goodreads/A36VM425M52BHK","id":"kca://profile:goodreads/A36VM425M52BHK"},"book":{"__ref":"Book:kca://book/amzn1.gr.book.v3.k75t-UiRTUjslITy","id":"kca://book/amzn1.gr.book.v3.k75t-UiRTUjslITy"},"shelf":{"__typename":"Shelf","name":"read","displayName":"Read","editable":false,"default":true,"actionType":"add_to_read","sortOrder":2,"webUrl":"https://www.goodreads.com/review/list/18379101?shelf=read"},"taggings":[],"webUrl":"https://www.goodreads.com/review/show/5068853989"},"Review:kca://review:goodreads/amzn1.gr.review:goodreads.v1.VuasyS1dUUGU1igKs9jp7Q":{"__typename":"Review","id":"kca://review:goodreads/amzn1.gr.review:goodreads.v1.VuasyS1dUUGU1igKs9jp7Q","creator":{"__ref":"User:18379101"},"recommendFor":null,"updatedAt":1677228839138,"createdAt":1666824199106,"spoilerStatus":false,"lastRevisionAt":1666824215202,"text":"Short and Sweet Regency.\u003cbr /\u003eEach of these regency era stories are particular to one character. Eve