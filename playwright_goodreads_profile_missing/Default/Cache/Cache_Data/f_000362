me":"2019","webUrl":"https://www.goodreads.com/review/list/33189596?shelf=2019"}}],"webUrl":"https://www.goodreads.com/review/show/2727630053"},"Review:kca://review:goodreads/amzn1.gr.review:goodreads.v1.PPldYjSVANoVSZP-CbnW1w":{"__typename":"Review","id":"kca://review:goodreads/amzn1.gr.review:goodreads.v1.PPldYjSVANoVSZP-CbnW1w","creator":{"__ref":"User:33189596"},"recommendFor":null,"updatedAt":1721773154990,"createdAt":1551002932325,"spoilerStatus":false,"lastRevisionAt":1551008831858,"text":"\u003cb\u003e ★ 2 STARS ★ \u003c/b\u003e\u003cbr /\u003e\u003cbr /\u003e▬⋆▬⋆▬⋆▬⋆▬⋆▬⋆▬⋆▬⋆▬⋆▬⋆▬⋆▬⋆▬⋆▬⋆▬ \u003cbr /\u003e\u003cbr /\u003eMEU DEUS! \u003cbr /\u003eEsse livro quase me levou a loucura e não foi no bom sentido, infelizmente. \u003cbr /\u003eFaz tempo que não sinto tanta raiva e revolta durante uma leitura... Exagero meu? Talvez sim, talvez não...\u003cbr /\u003e\u003cbr /\u003eMas eu realmente estou ficando cansada de ler livros nesta temática onde a heroína não se impõe, não se valorize e bata de frente com quem quer que seja que a queira diminuir, prejudicar, maltratar ou sei la o que! \u003cbr /\u003e\u003cbr /\u003eAchei a dinâmica entre os personagens dessa história e principalmente a postura e ações da personagem feminina lamentáveis. Acho que ela conseguiu ultrapassar os limites do que é aceitável ou crível. Se é que isso é possível pois não concordo nem um pouco com o que li aqui. \u003cbr /\u003e\u003cbr /\u003eNão há muita inovação em relação a livros que abordem o mesmo assunto. Cada vez mais tenho a impressão de que determinados temas-assuntos abordados andam seguindo um padrão e não se sai disso. Não sei se não inovam e mudam a receita por medo ou simplesmente por comodidade porque este caminho deu certo com “aqueles” outros livros... \u003cbr /\u003e\u003cbr /\u003eAcho isso frustrante, ainda mais neste caso. Mas ainda tenho uma pontinha de esperança que alguém crie uma personagem à altura e que de fato me faça voltar a sentir prazer em ler sem ter vontade de arrancar os cabelos ou revirar os olhos constantemente. \u003cbr /\u003e\u003cbr /\u003eDeixando de lado TODOS os pontos que eu não gostei, tenho que admitir que a escrita e narrativa foram boas. Daquelas viciantes e fluidas que não conseguimos largar mesmo não curtindo a história ou personagens. Por diversas vezes tive vontade de abandonar a leitura, mas esse foi o fator principal do porque não o fiz. Esse é o único ponto positivo desta leitura que me vem à mente no momento...","rating":2,"preReleaseBookSource":null,"shelving":{"__ref":"Shelving:{\"creator\":{\"id\":\"kca://profile:goodreads/A3EY3BXW0RR6LU\"},\"book\":{\"id\":\"kca://book/amzn1.gr.book.v1.IBRzpv1m0HCsdKwppXpVmQ\"}}"},"likeCount":47,"viewerHasLiked":null,"commentCount":10},"User:9345750":{"__typename":"User","legacyId":9345750,"imageUrlSquare":"https://i.gr-assets.com/images/S/compressed.photo.goodreads.com/users/1459271833i/9345750._UX200_CR0,0,200,200_.jpg","isAuthor":false,"viewerRelationshipStatus":null,"followersCount":205,"textReviewsCount":1260,"name":"Fre06 Begum","webUrl":"https://www.goodreads.com/user/show/9345750-fre06-begum","contributor":null,"id":9345750},"User:kca://profile:goodreads/A30O3SSQALYOSR":{"__typename":"User","id":"kca://profile:goodreads/A30O3SSQALYOSR"},"Shelving:{\"creator\":{\"id\":\"kca://profile:goodreads/A30O3SSQALYOSR\"},\"book\":{\"id\":\"kca://book/amzn1.gr.book.v1.IBRzpv1m0HCsdKwppXpVmQ\"}}":{"__typename":"Shelving","creator":{"__ref":"User:kca://profile:goodreads/A30O3SSQALYOSR","id":"kca://profile:goodreads/A30O3SSQALYOSR"},"book":{"__ref":"Book:kca://book/amzn1.gr.book.v1.IBRzpv1m0HCsdKwppXpVmQ","id":"kca://book/amzn1.gr.book.v1.IBRzpv1m0HCsdKwppXpVmQ"},"shelf":{"__typename":"Shelf","name":"read","displayName":"Read","editable":false,"default":true,"actionType":"add_to_read","sortOrder":2,"webUrl":"https://www.goodreads.com/review/list/9345750?shelf=read"},"taggings":[{"__typename":"Tagging","tag":{"__typename":"Tag","name":"abuse","webUrl":"https: