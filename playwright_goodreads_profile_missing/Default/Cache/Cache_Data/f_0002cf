rkStats","averageRating":4.63,"ratingsCount":131,"ratingsCountDist":[1,0,11,23,96],"textReviewsCount":45,"textReviewsLanguageCounts":[{"__typename":"TextReviewLanguageCount","count":45,"isoLanguageCode":"en"}]},"quotes({\"pagination\":{\"limit\":1}})":{"__typename":"ResourceQuotesConnection","webUrl":"https://www.goodreads.com/work/quotes/75829750","totalCount":0},"questions({\"pagination\":{\"limit\":1}})":{"__typename":"ResourceQuestionsConnection","totalCount":0,"webUrl":"https://www.goodreads.com/book/50979502/questions"},"topics({\"pagination\":{\"limit\":1}})":{"__typename":"ResourceTopicsConnection","webUrl":"https://www.goodreads.com/topic/list_book/50979502","totalCount":1},"viewerShelvings":null,"viewerShelvingsUrl":"/review/user_works/75829750","featuredKNH":{"__typename":"FeaturedKNHCollectionConnection","totalCount":0,"edges":[]},"giveaways":{"__typename":"GiveawaysConnection","edges":[]},"editions":{"__typename":"BooksConnection","webUrl":"https://www.goodreads.com/work/editions/75829750"}},"User:18044929":{"__typename":"User","legacyId":18044929,"imageUrlSquare":"https://i.gr-assets.com/images/S/compressed.photo.goodreads.com/users/1362421663i/18044929.jpg","isAuthor":false,"viewerRelationshipStatus":null,"followersCount":156,"textReviewsCount":1954,"name":"Elizabeth Neal","webUrl":"https://www.goodreads.com/user/show/18044929-elizabeth-neal","contributor":null,"id":18044929},"User:kca://profile:goodreads/A611Q35WFHP7R":{"__typename":"User","id":"kca://profile:goodreads/A611Q35WFHP7R"},"Shelving:{\"creator\":{\"id\":\"kca://profile:goodreads/A611Q35WFHP7R\"},\"book\":{\"id\":\"kca://book/amzn1.gr.book.v3.eshCIYs9dhlLsA8r\"}}":{"__typename":"Shelving","creator":{"__ref":"User:kca://profile:goodreads/A611Q35WFHP7R","id":"kca://profile:goodreads/A611Q35WFHP7R"},"book":{"__ref":"Book:kca://book/amzn1.gr.book.v3.eshCIYs9dhlLsA8r","id":"kca://book/amzn1.gr.book.v3.eshCIYs9dhlLsA8r"},"shelf":{"__typename":"Shelf","name":"read","displayName":"Read","editable":false,"default":true,"actionType":"add_to_read","sortOrder":2,"webUrl":"https://www.goodreads.com/review/list/18044929?shelf=read"},"taggings":[],"webUrl":"https://www.goodreads.com/review/show/3210948929"},"Review:kca://review:goodreads/amzn1.gr.review:goodreads.v1.AcDO0YBc0WuKVmfWceju0A":{"__typename":"Review","id":"kca://review:goodreads/amzn1.gr.review:goodreads.v1.AcDO0YBc0WuKVmfWceju0A","creator":{"__ref":"User:18044929"},"recommendFor":null,"updatedAt":1582940570494,"createdAt":1582931056566,"spoilerStatus":false,"lastRevisionAt":1582931059145,"text":"Lure of the Dragon - \u003cbr /\u003e\u003cbr /\u003eTessa, a private chef, had no clue shifters were real, until one tried to claim her as another helped her escape. Nothing like learning the hard way, right? Yeah, something tells me Tessa isn't finished with the lessons yet. I have a feeling there's more to come.\u003cbr /\u003e\u003cbr /\u003eKai, a dragon shifter, learned his own lesson due to a childhood experience. Never fall in love with a human, but when the one that belongs with you appears, desperate for help, how could he possibly adhere to that lesson?\u003cbr /\u003e\u003cbr /\u003eWhen Kai, and his fellow shifters and former military teammates, learn of Tessa's situation, as well as the connection to someone they're already aware of, they agree to help her, though Silas, the leader, insists upon reminding Kai of their no humans pact.\u003cbr /\u003e\u003cbr /\u003eBut something draws Kai and Tessa to one another, a feeling when the other is near, as well as a yearning that won't be denied for long. However, Kai must uncover why the other shifter is after Tessa, what secrets her family may hold, the origin of an heirloom left to her. Plus, factor in Kai's hesitancy as his present reminds him of his past and how one person's decision impacted everything.\u003cbr /\u003e\u003cbr /\u003eWill Kai and Tessa's story end as his parents' did? Can Kai keep her safe? Is Tessa fully human? Or was her family keeping secrets from her? What happens when Kai and Tessa act on their desire for one another? Will the thoughts and desires Tessa has dreamed of for so long finally make sense? Has Kai truly found his mate? Is there a HEA for them?\u003cbr /\u003e\u003cbr /\u003e\u003cbr /\u003eRebel Dragon - \u003cbr /\u003e\u003cbr /\u003eJenna, a surfer, is headed to Maui. A relaxing vacation to visit her sister, Jody, and enjoy the beautiful sights it is not. She's running from a stalker, and she has no idea who it could be or why they're after her. She just knows she doesn't want him to catch her.\u003cbr /\u003e\u003cbr /\u003eConnor, former Special Forces, has signed on, along with his fellow teammates, to help Silas with security. But first, he must pass his first assignment. Though he easily has the skills to do so, he doesn't have the focus, nor does his dragon, as the beautiful Jenna has captured his eye. Unfortunately, Jenna is off-limits.\u003cbr /\u003e\u003cbr /\u003eAs Connor and Jenna spend more time together to ensure her safety, the intense chemistry between them only grows stronger. Their ability to resist, however, continually fades.\u003cbr /\u003e\u003cbr /\u003eSoon, Connor and Jenna are exploring what's between them, both knowing how special what they found is. Connor's dragon knows Jenna is their other half, but Jenna is slowly making her way through the knowledge that shifters exist, and the man she's falling for is one of them.\u003cbr /\u003e\u003cbr /\u003eCan Connor keep Jenna safe? Will Jenna realize not all shifters are bad? Who is after her and why? Will the danger surrounding Jenna always be there? Or will she and Connor get their HEA?\u003cbr /\u003e\u003cbr /\u003eOne-click now and follow along as two people meet under unique circumstances and discover a love that was always meant to be.\u003cbr /\u003e\u003cbr /\u003e**I voluntarily read and reviewed an Advanced Reader Copy of this book.**\u003cbr /\u003e\u003cbr /\u003e\u003cbr /\u003eFire Maidens: Paris - \u003cbr /\u003e\u003cbr /\u003eWho doesn't dream of going to Paris? Well, Natalie actually did it, and it's not exactly everything she'd hoped it would be. It's more... She learns there are others in the world, those with abilities you only read about. And there are those who believe she's one of them. Encountering gargoyles, vampires, and dragons might sound fascinating, but it can also be terrifying if one is determined to claim you for reasons you never expected.\u003cbr /\u003e\u003cbr /\u003eThankfully, she has a knight in slightly tarnished armor, though Tristan is willing to give it a brand new polish as he helps Natalie not only navigate a life she's just now learning about, but she could also be the woman he's meant to be with...if only he can keep her alive.\u003cbr /\u003e\u003cbr /\u003eWill Natalie accept what was once only a fairy tale as real? Can Tristan end the danger to her once and for all? What is she that draws so many to her, and for all the wrong reasons? Can she and Tristan get the HEA they're both craving?\u003cbr /\u003e\u003cbr /\u003eOne-click now and follow along as two people show each other that love can overcome everything. I'm loving this spinoff of the original series and look forward to the next book.\u003cbr /\u003e\u003cbr /\u003e**I voluntarily read and reviewed an Advanced Reader Copy of this book.**","rating":4,"preReleaseBookSource":null,"shelving":{"__ref":"Shelving:{\"creator\":{\"id\":\"kca://profile:goodreads/A611Q35WFHP7R\"},\"book\":{\"id\":\"kca://book/amzn1.gr.book.v3.eshCIYs9dhlLsA8r\"}}"},"likeCount":3,"viewerHasLiked":null,"commentCount":0},"User:42214962":{"__typename":"User","legacyId":42214962,"imageUrlSquare":"https://i.gr-assets.com/images/S/compressed.photo.goodreads.com/users/1476195358i/42214962._UY200_CR42,0,200,200_.jpg","isAuthor":false,"viewerRelationshipStatus":null,"followersCount":146,"textReviewsCount":50001,"name":"Coco.V","webUrl":"https://www.goodreads.com/user/show/42214962-coco-v"