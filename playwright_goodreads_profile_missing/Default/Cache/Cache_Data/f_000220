UQwqagxa3c3w5g"}},{"__typename":"BookReviewsEdge","node":{"__ref":"Review:kca://review:goodreads/amzn1.gr.review:goodreads.v1.UZIy6Zjj54RCVzcuktwuRQ"}},{"__typename":"BookReviewsEdge","node":{"__ref":"Review:kca://review:goodreads/amzn1.gr.review:goodreads.v1.ognub3ZK4WktuERzYgV9uw"}}],"pageInfo":{"__typename":"PageInfo","prevPageToken":"MTQ3NCwxNTA4ODQxNzU3MDAw","nextPageToken":"NTMsMTU3MDUyOTY5OTg4NA"}}},"User:31000522":{"__typename":"User","legacyId":31000522,"viewerRelationshipStatus":null,"followersCount":302,"id":31000522},"Contributor:kca://author/amzn1.gr.author.v1.MaDfajU0qZYBk69v5G1ILw":{"__typename":"Contributor","id":"kca://author/amzn1.gr.author.v1.MaDfajU0qZYBk69v5G1ILw","legacyId":13776517,"name":"Melissa A. Craven","description":"Melissa A. Craven (the \"A\" stands for Ann—in case you were wondering) was born near Atlanta, Georgia, but moved to Cleveland, Ohio at the age of seventeen. She still thinks of Cleveland as home, so it was only natural for Emerge to take place there.\u003cbr /\u003eToday, she is back in Atlanta—for some reason she can't seem to stay away from the ungodly heat that makes her long for things like \"lake effect snow\" and wind that will knock you flat.\u003cbr /\u003eMelissa decided a long time ago that the “life checklist” everyone else was clutching so tightly in their fists, just wasn’t for her. She does everything backwards because she is weird like that, but then, she is an artist and artists are notoriously \"unique\" and \"quirky.\"\u003cbr /\u003eShe is an avid student of art and design, and received her Bachelor of Fine Arts from the University of West Georgia in 2009. She worked as an interior designer for several years, but she's always thought she might like to be a writer when she grows up.\u003cbr /\u003eIn her spare time, if she has any, she enjoys shopping for derelict furniture she refinishes to exercise the interior design part of her brain.","isGrAuthor":true,"works":{"__typename":"ContributorWorksConnection","totalCount":57},"profileImageUrl":"https://i.gr-assets.com/images/S/compressed.photo.goodreads.com/authors/1432844034i/13776517._UX200_CR0,14,200,200_.jpg","webUrl":"https://www.goodreads.com/author/show/13776517.Melissa_A_Craven","viewerIsFollowing":null,"followers":{"__typename":"ContributorFollowersConnection","totalCount":302},"user":{"__ref":"User:31000522"}},"Series:kca://series/amzn1.gr.series.v1.v7MZqzPoqFvxw34VnjWu-w":{"__typename":"Series","id":"kca://series/amzn1.gr.series.v1.v7MZqzPoqFvxw34VnjWu-w","title":"Immortals of Indriell","webUrl":"https://www.goodreads.com/series/153786-immortals-of-indriell"},"Book:kca://book/amzn1.gr.book.v1.pSQs4Lh0gZFnaOJE5qIRnw":{"__typename":"Book","id":"kca://book/amzn1.gr.book.v1.pSQs4Lh0gZFnaOJE5qIRnw","legacyId":40658068,"webUrl":"https://www.goodreads.com/book/show/40658068-the-judgment","viewerShelving":null,"title":"The Judgment","titleComplete":"The Judgment (Emerge, #2)","description":"The prophecy's about you, Red...\u003cbr /\u003e\u003cbr /\u003eAllie Carmichael has been haunted by those words for months. After dropping a huge bombshell and then leaving her in limbo, Greggory McBrien still hasn't given her the answers she craves. The knowledge of her past and the absence of both Gregg and her father have left Allie an angry, twisted mess of emotions. She still feels an immeasurable amount of guilt for her mistakes that left her scarred for life and her friend, Quinn a captive of the Coalition. Allie finds herself constantly dancing on the edge of losing control of her power, too afraid to confide in anyone––even her handsome and broody best friend, Aidan. \u003cbr /\u003e\u003cbr /\u003eA chance encounter at a dangerous nightclub reserved for Unproven Immortals, gives Allie and her friends the missing piece of the puzzle. If they have any hope of bringing Quinn home, they have to act quickly. \u003cbr /\u003e\u003cbr /\u003eAs Allie approaches her seventeenth birthday, the nightmares that only Aidan can keep at bay, return with a vengeance and she vows to finally face them on her own. But she struggles to understand what her clairvoyant gift is trying to tell her. When she finally begins to truly understand her gift, she fears it might be too late––and this time the price for her mistakes will be too high. \u003cbr /\u003e\u003cbr /\u003eLast time she was afraid. This time she's angry.","description({\"stripped\":true})":"The prophecy's about you, Red...\r\n\r\nAllie Carmichael has been haunted by those words for months. After dropping a huge bombshell and then leaving her in limbo, Greggory McBrien still hasn't given her the answers she craves. The knowledge of her past and the absence of both Gregg and her father have left Allie an angry, twisted mess of emotions. She still feels an immeasurable amount of guilt for her mistakes that left her scarred for life and her friend, Quinn a captive of the Coalition. Allie finds herself constantly dancing on the edge of losing control of her power, too afraid to confide in anyone––even her handsome and broody best friend, Aidan.  \r\n\r\nA chance encounter at a dangerous nightclub reserved for Unproven Immortals, gives Allie and her friends the missing piece of the puzzle. If they have any hope of bringing Quinn home, they have to act quickly. \r\n\r\nAs Allie approaches her seventeenth birthday, the nightmares that only Aidan can keep at bay, return with a vengeance and she vows to finally face them on her own. But she struggles to understand what her clairvoyant gift is trying to tell her. When she finally begins to truly understand her gift, she fears it might be too late––and this time the price for her mistakes will be too high. \r\n\r\nLast time she was afraid. This time she's angry.","primaryContributorEdge":{"__typename":"BookContributorEdge","node":{"__ref":"Contributor:kca://author/amzn1.gr.author.v1.MaDfajU0qZYBk69v5G1ILw"},"role":"Author"},"secondaryContributorEdges":[],"imageUrl":"https://m.media-amazon.com/images