s.v1.TWJpbhFBnxxQGbz7clZtBA","creator":{"__ref":"User:2658790"},"recommendFor":null,"updatedAt":1472275631972,"createdAt":1257206352000,"spoilerStatus":false,"lastRevisionAt":1300463623000,"text":"History writes off the infamous Juana 'la loca' as the insane Queen of Castile. However, C.W. Gortner finally gives voice to this courageous woman and the possibilty that her madness was not inherited but a result of years of torment, abuse, isolation and the final cruel blows of betrayl by the men she loved and trusted. \u003cbr /\u003eBooks such as this are a subtle reminder that ''His''tory can be a clever instrument to suppress the truth of the greedy and ambitious. ","rating":4,"preReleaseBookSource":null,"shelving":{"__ref":"Shelving:{\"creator\":{\"id\":\"kca://profile:goodreads/A2BOWBZANHYXAL\"},\"book\":{\"id\":\"kca://book/amzn1.gr.book.v1.fJ6MLDclZacbZS3FjeH1hg\"}}"},"likeCount":5,"viewerHasLiked":null,"commentCount":10},"User:3803025":{"__typename":"User","legacyId":3803025,"imageUrlSquare":"https://i.gr-assets.com/images/S/compressed.photo.goodreads.com/users/1441050255i/3803025._UX200_CR0,77,200,200_.jpg","isAuthor":false,"viewerRelationshipStatus":null,"followersCount":4,"textReviewsCount":336,"name":"Rio (Lynne)","webUrl":"https://www.goodreads.com/user/show/3803025-rio-lynne","contributor":null,"id":3803025},"User:kca://profile:goodreads/A1EC43H2BCYJ57":{"__typename":"User","id":"kca://profile:goodreads/A1EC43H2BCYJ57"},"Shelving:{\"creator\":{\"id\":\"kca://profile:goodreads/A1EC43H2BCYJ57\"},\"book\":{\"id\":\"kca://book/amzn1.gr.book.v1.rampJ9NypA3J-JBXHnepCg\"}}":{"__typename":"Shelving","creator":{"__ref":"User:kca://profile:goodreads/A1EC43H2BCYJ57","id":"kca://profile:goodreads/A1EC43H2BCYJ57"},"book":{"__ref":"Book:kca://book/amzn1.gr.book.v1.rampJ9NypA3J-JBXHnepCg","id":"kca://book/amzn1.gr.book.v1.rampJ9NypA3J-JBXHnepCg"},"shelf":{"__typename":"Shelf","name":"read","displayName":"Read","editable":false,"default":true,"actionType":"add_to_read","s