t5i4SOUOIrvUTTB8Q"},"Shelving:{\"creator\":{\"id\":\"kca://profile:goodreads/A3ITY13GK67FON\"},\"book\":{\"id\":\"kca://book/amzn1.gr.book.v1.SZ9uUt5i4SOUOIrvUTTB8Q\"}}":{"__typename":"Shelving","creator":{"__ref":"User:kca://profile:goodreads/A3ITY13GK67FON","id":"kca://profile:goodreads/A3ITY13GK67FON"},"book":{"__ref":"Book:kca://book/amzn1.gr.book.v1.SZ9uUt5i4SOUOIrvUTTB8Q","id":"kca://book/amzn1.gr.book.v1.SZ9uUt5i4SOUOIrvUTTB8Q"},"shelf":{"__typename":"Shelf","name":"read","displayName":"Read","editable":false,"default":true,"actionType":"add_to_read","sortOrder":2,"webUrl":"https://www.goodreads.com/review/list/3332895?shelf=read"},"taggings":[],"webUrl":"https://www.goodreads.com/review/show/1388669407"},"Review:kca://review:goodreads/amzn1.gr.review:goodreads.v1.A24dVUzNkIwC_dfXDzfnIw":{"__typename":"Review","id":"kca://review:goodreads/amzn1.gr.review:goodreads.v1.A24dVUzNkIwC_dfXDzfnIw","creator":{"__ref":"User:3332895"},"recommendFor":null,"updatedAt":1783999216672,"createdAt":1441928308000,"spoilerStatus":false,"lastRevisionAt":1442401505000,"text":"I have come to the conclusion after reading this novel that to be a women born into royalty, up until present times, was a curse rather than a privilege. Women were used as pawns in a human chess match. I lost many hours of sleep reading hoping that something, anything, would go in Juana's favor (note: I forced myself not to use Google to see how it all would played out). Even the most stable of people would loose any semblance of sanity after the events she endured. Sane or not, in the end, she was still a woman, a daughter and a mother who deserved much more that what life gave her. I commend CWG on highlighting the woman behind the label. A very compelling novel.","rating":5,"preReleaseBookSource":null,"shelving":{"__ref":"Shelving:{\"creator\":{\"id\":\"kca://profile:goodreads/A3ITY13GK67FON\"},\"book\":{\"id\":\"kca://book/amzn1.gr.book.v1.SZ9uUt5i4SOUOIrvUTTB8Q\"}}"},"likeCount":71,"viewerHasLiked":null,"commentCount":6},"User:2752994":{"__typename":"User","legacyId":2752994,"imageUrlSquare":"https://i.gr-assets.com/images/S/compressed.photo.goodreads.com/users/1552868566i/2752994._UX200_CR0,7,200,200_.jpg","isAuthor":false,"viewerRelationshipStatus":null,"followersCount":1476,"textReviewsCount":1290,"name":"Dem","webUrl":"https://www.goodreads.com/user/show/2752994-dem","contributor":null,"id":2752994},"User:kca://profile:goodreads/A2FZ7BD9MTMAIQ":{"__typename":"User","id":"kca://profile:goodreads/A2FZ7BD9MTMAIQ"},"Shelving:{\"creator\":{\"id\":\"kca://profile:goodreads/A2FZ7BD9MTMAIQ\"},\"book\":{\"id\":\"kca://book/amzn1.gr.book.v1.rampJ9NypA3J-JBXHnepCg\"}}":{"__typename":"Shelving","creator":{"__ref":"User:kca://profile:goodreads/A2FZ7BD9MTMAIQ","id":"kca://profile:goodreads/A2FZ7BD9MTMAIQ"},"book":{"__ref":"Book:kca://book/amzn1.gr.book.v1.rampJ9NypA3J-JBXHnepCg","id":"kca://book/amzn1.gr.book.v1.rampJ9NypA3J-JBXHnepCg"},"shelf":{"__typename":"Shelf","name":"read","displayName":"Read","editable":false,"default":true,"actionType":"add_to_read","sortOrder":2,"webUrl":"https://www.goodreads.com/review/list/2752994?shelf=read"},"taggings":[],"webUrl":"https://www.goodreads.com/review/show/865079964"},"Review:kca://review:goodreads/amzn1.gr.review:goodreads.v1.R_v3Lc4qgUWrd5YrBoX-Hw":{"__typename":"Review","id":"kca://review:goodreads/amzn1.gr.review:goodreads.v1.R_v3Lc4qgUWrd5YrBoX-Hw","creator":{"__ref":"User:2752994"},"recommendFor":null,"updatedAt":1770326170572,"createdAt":1393361341000,"spoilerStatus":false,"lastRevisionAt":1473071611000,"text":"The last Queen a Novel by C.W. Gortner tells the moving tale of Juana la Loca (the mad).\u003cbr /\u003e\u003cbr /\u003e\" \u003cb\u003e\n  \u003ci\u003e She was if nothing else an extraordinary figure for her time\" \u003c/i\u003e\n\u003c/b\u003e \u003cbr /\u003e\u003cbr /\u003eI love Historical Fiction but am not a fan of novels about the English Throne and was delighted when I came across this Novel which brings to life Juana of Castile, the third child of Queen Isabel and King Ferdinand of Spain. who would become the last queen of Spanish blood to inherit her country's throne. This is a gripping and moving tale and also an eyeopener at how women were used as pawns in the fight for power and crowns at the time.\u003cbr /\u003e\u003cbr /\u003eI knew nothing of Juana of Castile and I enjoyed learning about the passion, politics and betrayals of this spirited queen which through this well written novel I am delighted to say I have learned so much.\u003cbr /\u003e\u003cbr /\u003eThis is a very gripping and well written novel and I did spent some time googling to find out what was fiction and what was truth about this story. But I am delighted to say that the author clears up any questions one might have on this matter at the end of the novel and quite clearly he has taken some liberties with the storyline but he has has explained these liberties quite satisfactorily in my opinion and has appeared to do excellent research on the story.\u003cbr /\u003e\u003cbr /\u003eI listened to this as an audio book and while the narrator was adequate I felt she raced through the story as if there was a pack of Lions after her, I did try to slow down the narration but eventually I got used to it and it all worked out in the end.\u003cbr /\u003e\u003cbr /\u003eThis is certainly one of those books that transports you to the past and while doing so you learn something on the trip and that is what makes a historical fiction so enjoyable for me.\u003cbr /\u003e\u003cbr /\u003eLovers of Historical Fiction will really enjoy this well researched and interesting story.\u003cbr /\u003e","rating":4,"preReleaseBookSource":null,"shelving":{"__ref":"Shelving:{\"creator\":{\"id\":\"kca://profile:goodreads/A2FZ7BD9MTMAIQ\"},\"book\":{\"id\":\"kca://book/amzn1.gr.book.v1.rampJ9NypA3J-JBXHnepCg\"}}"},"likeCount":55,"viewerHasLiked":null,"commentCount":12},"User:40583939":{"__typename":"User","legacyId":4058393