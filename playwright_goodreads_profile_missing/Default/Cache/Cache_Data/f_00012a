eads/A3OTEU49566MVR","id":"kca://profile:goodreads/A3OTEU49566MVR"},"book":{"__ref":"Book:kca://book/amzn1.gr.book.v3.3JFAhashUFaPcUC-","id":"kca://book/amzn1.gr.book.v3.3JFAhashUFaPcUC-"},"shelf":{"__typename":"Shelf","name":"read","displayName":"Read","editable":false,"default":true,"actionType":"add_to_read","sortOrder":2,"webUrl":"https://www.goodreads.com/review/list/760518?shelf=read"},"taggings":[],"webUrl":"https://www.goodreads.com/review/show/3158706238"},"Review:kca://review:goodreads/amzn1.gr.review:goodreads.v1.1Bywauf1e2FWs_4j1meYPw":{"__typename":"Review","id":"kca://review:goodreads/amzn1.gr.review:goodreads.v1.1Bywauf1e2FWs_4j1meYPw","creator":{"__ref":"User:760518"},"recommendFor":null,"updatedAt":1583434571014,"createdAt":1583434531392,"spoilerStatus":false,"lastRevisionAt":1583434570792,"text":"I'm always excited with Traci Hunter Abramson comes out with a new book...especially when it's part of a series I enjoy. I couldn't wait to get my hands on this one, but I will admit that I never gave Levi much thought in the other books. I think I thought Allen and his bomb sniffing dog would get the next book, so I was pleasantly surprised. \u003cbr /\u003e\u003cbr /\u003eI don't think you would need to read the other books in the series before you read Royal Heir. It would be more enjoyable for you because you understand some of the minor characters more, but I don't think it's necessary. \u003cbr /\u003e\u003cbr /\u003eI loved the bold cover. Not bold in a bright color sort of way (which the other Royal series books were bright) but I loved the crown over the light. It's simple and it just kinda hits you, and I love it.\u003cbr /\u003e\u003cbr /\u003eI actually really liked that at the beginning of the book Levi was not excited to have Cassie around. She was a spoiled princess, and I loved that we got to see that change. I love what getting to know others and letting others in does to a person, and so that's fun for me to read. \u003cbr /\u003e\u003cbr /\u003eThis book was well written, entertaining (in a \"I don't want to put this down\" sort of way), and classically Abramson. I might actually change that. Some authors later writings get a little old, but it seems to me that Abramson's just keep getting better. I can't wait until her next one! \u003cbr /\u003e\u003cbr /\u003e*I received a copy from the publisher. All opinions expressed are my own.","rating":4,"preReleaseBookSource":null,"shelving":{"__ref":"Shelving:{\"creator\":{\"id\":\"kca://profile:goodreads/A3OTEU49566MVR\"},\"book\":{\"id\":\"kca://book/amzn1.gr.book.v3.3JFAhashUFaPcUC-\"}}"},"likeCount":0,"viewerHasLiked":null,"commentCount":0},"Contributor:kca://author/amzn1.gr.author.v1.dZqzy0Q6fCoEXDh1I1tuRQ":{"__typename":"Contributor","id":"kca://author/amzn1.gr.author.v1.dZqzy0Q6fCoEXDh1I1tuRQ","works":{"__typename":"ContributorWorksConnection","totalCount":97}},"User:4673920":{"__typename":"User","legacyId":4673920,"imageUrlSquare":"https://i.gr-assets.com/images/S/compressed.photo.goodreads.com/users/1772403098i/4673920._UX200_CR0,0,200,200_.jpg","isAuthor":true,"viewerRelationshipStatus":null,"followersCount":463,"textReviewsCount":1621,"name":"Donna Weaver","webUrl":"https://www.goodreads.com/user/show/4673920-donna-weaver","contributor":{"__ref":"Contributor:kca://author/amzn1.gr.author.v1.dZqzy0Q6fCoEXDh1I1tuRQ"},"id":4673920},"User:kca://profile:goodreads/A2PLJMTWBIUGI3":{"__typename":"User","id":"kca://profile:goodreads/A2PLJMTWBIUGI3"},"Book:kca://book/amzn1.gr.book.v3.vIftLXe_SjrNH4od":{"__typename":"Book","id":"kca://book/amzn1.gr.book.v3.vIftLXe_SjrNH4od"},"Shelving:{\"creator\":{\"id\":\"kca://profile:goodreads/A2PLJMTWBIUGI3\"},\"book\":{\"id\":\"kca://book/amzn1.gr.book.v3.vIftLXe_SjrNH4od\"}}":{"__typename":"Shelving","creator":{"__ref":"User:kca://profile:goodreads/A2PLJMTWBIUGI3","id":"kca://profile:goodreads/A2PLJMTWBIUGI3"},"book":{"__ref":"Book:kca://book/amzn1.gr.book.v3.vIftLXe_SjrNH4od","id":"kca://book/amzn1.gr.book.v3.vIftLXe_SjrNH4od"},"shelf":{"__typename":"Shelf","name":"read","displayName":"Read","editable":false,"default":true,"actionType":"add_to_read","sortOrder":2,"webUrl":"https://www.goodreads.com/review/list/4673920?shelf=read"},"taggings":[],"webUrl":"https://www.goodreads.com/review/show/3049376081"},"Review:kca://review:goodreads/amzn1.gr.review:goodreads.v1.Xx18Vh64JH-xLaXAyLzU2g":{"__typename":"Review","id":"kca://review:goodreads/amzn1.gr.review:goodreads.v1.Xx18Vh64JH-xLaXAyLzU2g","creator":{"__ref":"User:4673920"},"recommendFor":null,"updatedAt":1594640270913,"createdAt":1594639929742,"spoilerStatus":false,"lastRevisionAt":1594640270664,"text":"WHAT IT'S ABOUT\u003cbr /\u003eWithin a fairy-tale palace overlooking the azure waters of the Mediterranean, Princess Cassandra of Sereno leads a charmed life—until that life is nearly cut short in an assassination attempt. Desperate to protect his daughter, the king sends the princess to safety in the one place he trusts: the neighboring country of Meridia. There, Cassie’s life is placed in the hands of a man who possesses the skills to protect her. CIA agent Levi Marin has years of experience pretending to be someone he’s not, but posing as the boyfriend of a real-life princess is new, even to him.\u003cbr /\u003e\u003cbr /\u003eWith the CIA and Interpol hot on the trail of the assassin, Levi and Cassie do their best to blend in in Meridia and to remain professional amid their charade. Yet despite their best efforts, the charade begins to feel all too real. Their chemistry is undeniable, but forgetting the dangerous reality of their situation could prove a deadly mistake. Cassie’s would-be killer is still at large, and her search for answers is leading her ever closer to a shocking revelation that will rock the monarchy of Sereno to its core. \u003cbr /\u003e\u003cbr /\u003eMY TAKE\u003cbr /\u003eI'd just finished listening to the audiobook for Royal Brides, so when I saw this one was Levi's HEA, I was excited. It was a fun and complicated story with some nice twists. As the reader, knowing what was going on --AND know what would happen when that came to light--added to the tension.\u003cbr /\u003e\u003cbr /\u003eAnother excellent story!","rating":5,"preReleaseBookSource":null,"shelving":{"__ref":"Shelving:{\"creator\":{\"id\":\"kca://profile:goodreads/A2PLJMTWBIUGI3\"},\"book\":{\"id\":\"kca://book/amzn1.gr.book.v3.vIftLXe_SjrNH4od\"}}"},"likeCount":1,"viewerHasLiked":null,"commentCount":0},"User:1401537":{"__typename":"User","legacyId":1401537,"imageUrlSquare":"https://i.gr-assets.com/images/S/compressed.photo.goodreads.com/users/1613838867i/1401537._UY200_CR33,0,200,200_.jpg","isAuthor":false,"viewerRelationshipStatus":null,"followersCount":74,"textReviewsCount":4556,"name":"Kaye","webUrl":"https://www.goodreads.com/user/show/1401537-kaye","contributor":null,"id":1401537},"User:kca://profile:goodreads/A3O87Z7E7OM1IT":{"__typename":"User","id":"kca://profile:goodreads/A3O87Z7E7OM1IT"},"Shelving:{\"creator\":{\"id\":\"kca://profile:goodreads/A3O87Z7E7OM1IT\"},\"book\":{\"id\":\"kca://book/amzn1.gr.book.v3.3JFAhashUFaPcUC-\"}}":{"__typename":"Shelving","creator":{"__ref":"User:kca://profile:goodreads/A3O87Z7E7OM1IT","id":"kca://profile:goodreads/A3O87Z7E7OM1IT"},"book":{"__ref":"Book:kca://book/amzn1.gr.book.v3.3JFAhashUFaPcUC-","id":"kca://book/amzn1.gr.book.v3.3JFAhashUFaPcUC-"},"shelf":{"__typename":"Shelf","name":"read","displayName":"Read","editable":false,"default":true,"actionType":"add_to_read","sortOrder":2,"webUrl":"https://www.goodreads.com/review/list/1401537?shelf=read"},"taggings":[{"__typename":"Tagging","tag":{"__typename":"Tag","name":"books-in-a-series-mysteries","webUrl":"https://www.goodreads.com/review/list/1401537?shelf=books-in-a-series-mysteries"}},{"__typename":"Tagging","tag":{"__typename":"Tag","name":"books-in-a-series-romance","webUrl":"https://www.goodreads.com/review/list/1401537?shelf=books-in-a-series-romance"}},{"__typename":"Tagging","tag":{"__typename":"Tag","name":"clean","webUrl":"https://www.goodreads.com/review/list/1401537?shelf=clean"}},{"__typename":"Tagging","tag":{"__typename":"Tag","name":"spy-or-gov-agency","webUrl":"https://www.goodreads.com/review/list/1401537?shelf=spy-or-gov-agency"}},{"__typename":"Tagging","tag":{"__typename":"Tag","name":"2024","webUrl":"https://www.goodreads.com/review/list/1401537?shelf=2024"}}],"webUrl":"https://www.goodreads.com/review/show/7076668101"},"Review:kca://review:goodreads/amzn1.gr.review:goodreads.v2.2024121117.65b5667e-69cd-4aec-9abe-070e4db0beca":{"__typename":"Review","id":"kca://review:goodreads/amzn1.gr.review:goodreads.v2.2024121117.65b5667e-69cd-4aec-9abe-070e4db0beca","creator":{"__ref":"User:1401537"},"recommendFor":null,"updatedAt":1733937516142,"createdAt":1733937460917,"spoilerStatus":false,"lastRevisionAt":1733937515958,"text":"I finished Royal Duty (Sept 2024) and realized I had missed this novel from March of 2020. I’m going to guess the Covid shutdown somehow made me not pay attention to a book from an author I enjoy. Princess Cassandra of Sereno (Cassie) survives an assassination attempt in her family palace. Her father, the King, sends her to a neighboring Mediterranean country for safety. She is staying in a secure Royal castle retreat. Levi Marin is head of security and it is his assignment to protect her at all costs. She thinks he is a native of Meridia but he is actually a very entrenched CIA agent. (The local ruling family knows his full identity.) A lot of action is happening. Banks are simultaneously being robbed across Europe and it all ties to an old treaty and the rules of succession for Sereno when the King dies. \u003cbr /\u003e\u003cbr /\u003eCassie is of course a hard working Royal and gets her first taste of a less formal life at the castle. She poses as Levi’s girlfriend to the staff and security officers. And maybe the romance isn’t as pretend as it seems. This is a really nice balance of action, and romance. I’m glad I realized I’d missed a book and was able to get it easily at my local library. I did notice that the lead in the next book which was just published makes an appearance at the end of this one. I marvel that the author can keep track of her various series when for example in this case it took four years for the next book.","rating":4,"preReleaseBookSource":null,"shelving":{"__ref":"Shelving:{\"creator\":{\"id\":\"kca://profile:goodreads/A3O87Z7E7OM1IT\"},\"book\":{\"id\":\"kca://book/amzn1.gr.book.v3.3JFAhashUFaPcUC-\"}}"},"likeCount":2,"viewerHasLiked":null,"commentCount":0},"User:1365026":{"__typename":"User","legacyId":1365026,"imageUrlSquare":"","isAuthor":false,"viewerRelationshipStatus":null,"followersCount":8,"textReviewsCount":687,"name":"Darla","webUrl":"https://www.goodreads.com/user/show/1365026-darla","contributor":null,"id":1365026},"User:kca://profile:goodreads/A1U8OB3F71Z6EH":{"__typename":"User","id":"kca://profile:goodreads/A1U8OB3F71Z6EH"},"Shelving:{\"creator\":{\"id\":\"kca://profile:goodreads/A1U8OB3F71Z6EH\"},\"book\":{\"id\":\"kca://book/amzn1.gr.book.v3.3JFAhashUFaPcUC-\"}}":{"__typename":"Shelving","creator":{"__ref":"User:kca://profile:goodreads/A1U8OB3F71Z6EH","id":"kca://profile:goodreads/A1U8OB3F71Z6EH"},"book":{"__ref":"Book:kca://book/amzn1.gr.book.v3.3JFAhashUFaPcUC-","id":"kca://book/amzn1.gr.book.v3.3JFAhashUFaPcUC-"},"shelf":{"__typename":"Shelf","name":"read","displayName":"Read","editable":false,"default":true,"actionType":"add_to_read","sortOrder":2,"webUrl":"https://www.goodreads.com/review/list/1365026?shelf=read"},"taggings":[],"webUrl":"https://www.goodreads.com/review/show/3405937590"},"Review:kca://review:goodreads/amzn1.gr.review:goodreads.v1.7q7N2gsWO_sLl_TTTs7kDQ":{"__typename":"Review","id":"kca://review:goodreads/amzn1.gr.review:goodreads.v1.7q7N2gsWO_sLl_TTTs7kDQ","creator":{"__ref":"User:1365026"},"recommendFor":null,"updatedAt":1592871408707,"createdAt":1592870343316,"spoilerStatus":false,"lastRevisionAt":1592871408433,"text":"(Genre:Fiction, suspense, romance) Another installment in Traci Hunter Abramson's Royal series, this story is centered on Meridian's neighboring kingdom, Serrano. When an attempt is made on the life of the royal heir and princess, King Alejandro sends her to Meridian, where her safety is entrusted to Levi Marin, friend and former coworker to Princess Janessa. Levi plans on introducing Princess Cassandra as a security professional and coworker, but Cassie doesn't feel like she can pull off that identity. She chooses instead to be Levi's new girlfriend and Levi is determined to enjoy the charade, all the while he slowly starts to fall for the undercover princess. But Levi is keeping a lot of secrets from Cassie and they are secrets that could drive them apart, regardless of the attraction they feel for one another.\u003cbr /\u003eThis is a cute story. It's very unrealistic in some spots but still a lot of fun to lose a few hours in it's many pages. Abramson always does such a nice job in her books of creating characters that you really like and can't help cheering for, and this book is no different. She is always a \"must read author\" in my book. Besides her characters, she does a nice job setting up her bad guy and their motivations. Fun story. 3.5 stars","rating":3,"preReleaseBookSource":null,"shelving":{"__ref":"Shelving:{\"creator\":{\"id\":\"kca://profile:goodreads/A1U8OB3F71Z6EH\"},\"book\":{\"id\":\"kca://book/amzn1.gr.book.v3.3JFAhashUFaPcUC-\"}}"},"likeCount":0,"viewerHasLiked":null,"commentCount":0},"User:132382878":{"__typename":"User","legacyId":132382878,"imageUrlSquare":"https://i.gr-assets.com/images/S/compressed.photo.goodreads.com/users/1617427331i/132382878._UX200_CR0,34,200,200_.jpg","isAuthor":false,"viewerRelationshipStatus":null,"followersCount":0,"textReviewsCount":652,"name":"Alysha","webUrl":"https://www.goodreads.com/user/show/132382878-alysha","contributor":null,"id":132382878},"User:kca://profile:goodreads/A1GEEDJYMGGVDB":{"__typename":"User","id":"kca://profile:goodreads/A1GEEDJYMGGVDB"},"Shelving:{\"creator\":{\"id\":\"kca://profile:goodreads/A1GEEDJYMGGVDB\"},\"book\":{\"id\":\"kca://book/amzn1.gr.book.v3.3JFAhashUFaPcUC-\"}}":{"__typename":"Shelving","creator":{"__ref":"User:kca://profile:goodreads/A1GEEDJYMGGVDB","id":"kca://profile:goodreads/A1GEEDJYMGGVDB"},"book":{"__ref":"Book:kca://book/amzn1.gr.book.v3.3JFAhashUFaPcUC-","id":"kca://book/amzn1.gr.book.v3.3JFAhashUFaPcUC-"},"shelf":{"__typename":"Shelf","name":"read","displayName":"Read","editable":false,"default":true,"actionType":"add_to_read","sortOrder":2,"webUrl":"https://www.goodreads.com/review/list/132382878?shelf=read"},"taggings":[{"__typename":"Tagging","tag":{"__typename":"Tag","name":"read-in-2026","webUrl":"https://www.goodreads.com/review/list/132382878?shelf=read-in-2026"}}],"webUrl":"https://www.goodreads.com/review/show/6854667793"},"Review:kca://review:goodreads/amzn1.gr.review:goodreads.v1.4R4QiyKjRiAdhwr1Yxhoiw":{"__typename":"Review","id":"kca://review:goodreads/amzn1.gr.review:goodreads.v1.4R4QiyKjRiAdhwr1Yxhoiw","creator":{"__ref":"User:132382878"},"recommendFor":null,"updatedAt":1769575201389,"createdAt":1769574744337,"spoilerStatus":false,"lastRevisionAt":1769575201199,"text":"I’m so happy that Levi got his own Royals book. Cassie and Levi’s story was quite different from the previous books in the series for multiple reasons, all of which made for a new and suspense filled story. I also liked that we still saw some of our favorite characters from the previous books even while new characters were added and a new Royal line set up to follow. One of the questions I have is regarding CIA protocol and why Levi was almost always contacted by the director, is it because of his position, his role, or is that just the way it is. I’m pretty sure that’s going to be a question that’s never answered, but it’s there. Cassie seems a bit more rigid in her demeanor and attitude than the royals in Meiridia, but as the book progresses you see her change and realize that while her way worked, being more friends and/family with her staff was a way that she could change. I really liked the romance between Cassie and Levi. While it happened very quickly, they did spend a lot of time together, learning about each other and their lives. ","rating":4,"preReleaseBookSource":null,"shelving":{"__ref":"Shelving:{\"creator\":{\"id\":\"kca://profile:goodreads/A1GEEDJYMGGVDB\"},\"book\":{\"id\":\"kca://book/amzn1.gr.book.v3.3JFAhashUFaPcUC-\"}}"},"likeCount":0,"viewerHasLiked":null,"commentCount":0},"User:1987388":{"__typename":"User","legacyId":1987388,"imageUrlSquare":"https://i.gr-assets.com/images/S/compressed.photo.goodreads.com/users/1391051578i/1987388._UY200_CR6,0,200,200_.jpg","isAuthor":false,"viewerRelationshipStatus":null,"followersCount":0,"textReviewsCount":703,"name":"Michelle","webUrl":"https://www.goodreads.com/user/show/1987388-michelle","contributor":null,"id":1987388},"User:kca://profile:goodreads/A3N1DOFBA20NVZ":{"__typename":"User","id":"kca://profile:goodreads/A3N1DOFBA20NVZ"},"Shelving:{\"creator\":{\"id\":\"kca://profile:goodreads/A3N1DOFBA20NVZ\"},\"book\":{\"id\":\"kca://book/amzn1.gr.book.v3.YkdkB1vQCtermeAh\"}}":{"__typename":"Shelving","creator":{"__ref":"User:kca://profile:goodreads/A3N1DOFBA20NVZ","id":"kca://profile:goodreads/A3N1DOFBA20NVZ"},"book":{"__ref":"Book:kca://book/amzn1.gr.book.v3.YkdkB1vQCtermeAh","id":"kca://book/amzn1.gr.book.v3.YkdkB1vQCtermeAh"},"shelf":{"__typename":"Shelf","name":"read","displayName":"Read","editable":false,"default":true,"actionType":"add_to_read","sortOrder":2,"webUrl":"https://www.goodreads.com/review/list/1987388?shelf=read"},"taggings":[],"webUrl":"https://www.goodreads.com/review/show/3226752835"},"Review:kca://review:goodreads/amzn1.gr.review:goodreads.v1.3c2tiosGdu0W0a3t1F5BPg":{"__typename":"Review","id":"kca://review:goodreads/amzn1.gr.review:goodreads.v1.3c2tiosGdu0W0a3t1F5BPg","creator":{"__ref":"User:1987388"},"recommendFor":null,"updatedAt":1583926215403,"createdAt":1583925956374,"spoilerStatus":false,"lastRevisionAt":1583926215403,"text":"I love these books by Traci Hunter Abramson! They have the perfect combination of romance and action. I felt this was more romance than action, but I loved the good characters! While it was hard to believe that a Princess would fall in love with a commoner, I guess it happens, even in real life. I liked the mystery and it was nice that there wasn't some big conspiracy theory. I had an enjoyable time reading. This book is clean, but not really religious. Some characters are from previous books, but they don't give away the story from the previous books (although you know the protagonists survive!). It made me want to travel to this kingdom and sit on a private beach and watch the sun rise! Great book for winter when you can't cruise to warm locations or for reading on the beach!","rating":4,"preReleaseBookSource":null,"shelving":{"__ref":"Shelving:{\"creator\":{\"id\":\"kca://profile:goodreads/A3N1DOFBA20NVZ\"},\"book\":{\"id\":\"kca://book/amzn1.gr.book.v3.YkdkB1vQCtermeAh\"}}"},"likeCount":0,"viewerHasLiked":null,"commentCount":0},"User:76903201":{"__typename":"User","legacyId":76903201,"imageUrlSquare":"","isAuthor":false,"viewerRelationshipStatus":null,"followersCount":2,"textReviewsCount":196,"name":"LaRee Sutherland","webUrl":"https://www.goodreads.com/user/show/76903201-laree-sutherland","contributor":null,"id":76903201},"User:kca://profile:goodreads/A164TO7WVLWOY3":{"__typename":"User","id":"kca://profile:goodreads/A164TO7WVLWOY3"},"Shelving:{\"creator\":{\"id\":\"kca://profile:goodreads/A164TO7WVLWOY3\"},\"book\":{\"id\":\"kca://book/amzn1.gr.book.v3.YkdkB1vQCtermeAh\"}}":{"__typename":"Shelving","creator":{"__ref":"User:kca://profile:goodreads/A164TO7WVLWOY3","id":"kca://profile:goodreads/A164TO7WVLWOY3"},"book":{"__ref":"Book:kca://book/amzn1.gr.book.v3.YkdkB1vQCtermeAh","id":"kca://book/amzn1.gr.book.v3.YkdkB1vQCtermeAh"},"shelf":{"__typename":"Shelf","name":"read","displayName":"Read","editable":false,"default":true,"actionType":"add_to_read","sortOrder":2,"webUrl":"https://www.goodreads.com/review/list/76903201?shelf=read"},"taggings":[],"webUrl":"https://www.goodreads.com/review/show/3230175650"},"Review:kca://review:goodreads/amzn1.gr.review:goodreads.v1.YEchyd8CR23qq5tFMJ4ppg":{"__typename":"Review","id":"kca://review:goodreads/amzn1.gr.review:goodreads.v1.YEchyd8CR23qq5tFMJ4ppg","creator":{"__ref":"User:76903201"},"recommendFor":null,"updatedAt":1584176634750,"createdAt":1584176624405,"spoilerStatus":false,"lastRevisionAt":1584176634517,"text":"\u003cstrong\u003eDare to be Royal\u003c/strong\u003e\u003cbr /\u003e\u003cbr /\u003eThere is an assassination attempt on the King and Princess Cassandra. How could that be with such excellent castle security? When it is determined to be an attempt on Cassandra 's life, she and her sisters are put in safe keeping until the mystery is solved. Cassandra is put in the care of CIA Agent Levi Marin. Levi's specialty is security. He and Cassandra pretend to be boyfriend/girlfriend. With Ms Abramson's skillful writing, the reader gets caught up in the lives of royals; romance; suspense; worldwide crime organizations and more than one gun fight. A book to keep you up all night.","rating":5,"preReleaseBookSource":null,"shelving":{"__ref":"Shelving:{\"creator\":{\"id\":\"kca://profile:goodreads/A164TO7WVLWOY3\"},\"book\":{\"id\":\"kca://book/amzn1.gr.book.v3.YkdkB1vQCtermeAh\"}}"},"likeCount":0,"viewerHasLiked":null,"commentCount":0},"User:3904308":{"__typename":"User","legacyId":3904308,"imageUrlSquare":"https://i.gr-assets.com/images/S/compressed.photo.goodreads.com/users/1463892304i/3904308._UX200_CR0,24,200,200_.jpg","isAuthor":false,"viewerRelationshipStatus":null,"followersCount":72,"textReviewsCount":2970,"name":"Heidi","webUrl":"https://www.goodreads.com/user/show/3904308-heidi","contributor":null,"id":3904308},"User:kca://profile:goodreads/A2PSKUL067XUQA":{"__typename":"User","id":"kca://profile:goodreads/A2PSKUL067XUQA"},"Shelving:{\"creator\":{\"id\":\"kca://profile:goodreads/A2PSKUL067XUQA\"},\"book\":{\"id\":\"kca://book/amzn1.gr.book.v3.3JFAhashUFaPcUC-\"}}":{"__typename":"Shelving","creator":{"__ref":"User:kca://profile:goodreads/A2PSKUL067XUQA","id":"kca://profile:goodreads/A2PSKUL067XUQA"},"book":{"__ref":"Book:kca://book/amzn1.gr.book.v3.3JFAhashUFaPcUC-","id":"kca://book/amzn1.gr.book.v3.3JFAhashUFaPcUC-"},"shelf":{"__typename":"Shelf","name":"read","displayName":"Read","editable":false,"default":true,"actionType":"add_to_read","sortOrder":2,"webUrl":"https://www.goodreads.com/review/list/3904308?shelf=read"},"taggings":[{"__typename":"Tagging","tag":{"__typename":"Tag","name":"2020-books","webUrl":"https://www.goodreads.com/review/list/3904308?shelf=2020-books"}},{"__typename":"Tagging","tag":{"__typename":"Tag","name":"adult-suspense","webUrl":"https://www.goodreads.com/review/list/3904308?shelf=adult-suspense"}},{"__typename":"Tagging","tag":{"__typename":"Tag","name":"adult-romance","webUrl":"https://www.goodreads.com/review/list/3904308?shelf=adult-romance"}}],"webUrl":"https://www.goodreads.com/review/show/3398247182"},"Review:kca://review:goodreads/amzn1.gr.review:goodreads.v1.vQx3BxynaIAFK7rOz6R__g":{"__typename":"Review","id":"kca://review:goodreads/amzn1.gr.review:goodreads.v1.vQx3BxynaIAFK7rOz6R__g","creator":{"__ref":"User:3904308"},"recommendFor":null,"updatedAt":1593031023405,"createdAt":1592472505286,"spoilerStatus":false,"lastRevisionAt":1593031023149,"text":"In this companion novel to her Royals series, Abramson introduces readers to Princess Cassandra and the royal family of Sereno. After an assassination attempt fails, Cassie is sent away to Meredia, a neighboring country. While there, Cassie's safety is in the hands of Levi Marin, an American CIA agent who has spent two years building Meredia's Royal security. Nobody bothers to tell Cassie that Levi's an American though because of her family's well-known dislike of Americans. In order to provide the security that Cassie needs, Levi pretends to be Cassie's boyfriend. What neither of them expects is for real feelings to develop between them. Abramson has written another entertaining, believable tale of life as a royal. Cassie is a sympathetic character as she struggles to come to terms with having her life in danger, falling in love, and learning her father is sick. Levi's expertise regarding security is believable and fascinating as he works to keep Cassie (and his secret) safe. There's plenty of romance and suspense for those who enjoy those things. I also enjoyed the realistic portrayal of the challenges of being royal as well as the luxuries. A great addition to the Royals series.","rating":4,"preReleaseBookSource":null,"shelving":{"__ref":"Shelving:{\"creator\":{\"id\":\"kca://profile:goodreads/A2PSKUL067XUQA\"},\"book\":{\"id\":\"kca://book/amzn1.gr.book.v3.3JFAhashUFaPcUC-\"}}"},"likeCount":0,"viewerHasLiked":null,"commentCount":0},"User:6972927":{"__typename":"User","legacyId":6972927,"imageUrlSquare":"","isAuthor":false,"viewerRelationshipStatus":null,"followersCount":1,"textReviewsCount":411,"name":"Tiffany","webUrl":"https://www.goodreads.com/user/show/6972927-tiffany","contributor":null,"id":6972927},"User:kca://profile:goodreads/A96AJXRBFTZCO":{"__typename":"User","id":"kca://profile:goodreads/A96AJXRBFTZCO"},"Shelving:{\"creator\":{\"id\":\"kca://profile:goodreads/A96AJXRBFTZCO\"},\"book\":{\"id\":\"kca://book/amzn1.gr.book.v3.3JFAhashUFaPcUC-\"}}":{"__typename":"Shelving","creator":{"__ref":"User:kca://profile:goodreads/A96AJXRBFTZCO","id":"kca://profile:goodreads/A96AJXRBFTZCO"},"book":{"__ref":"Book:kca://book/amzn1.gr.book.v3.3JFAhashUFaPcUC-","id":"kca://book/amzn1.gr.book.v3.3JFAhashUFaPcUC-"},"shelf":{"__typename":"Shelf","name":"read","displayName":"Read","editable":false,"default":true,"actionType":"add_to_read","sortOrder":2,"webUrl":"https://www.goodreads.com/review/list/6972927?shelf=read"},"taggings":[],"webUrl":"https://www.goodreads.com/review/show/3503808181"},"Review:kca://review:goodreads/amzn1.gr.review:goodreads.v1.lTFowixnpBzHA6rf6htc2Q":{"__typename":"Review","id":"kca://review:goodreads/amzn1.gr.review:goodreads.v1.lTFowixnpBzHA6rf6htc2Q","creator":{"__ref":"User:6972927"},"recommendFor":null,"updatedAt":1597822922702,"createdAt":1597822307792,"spoilerStatus":false,"lastRevisionAt":1597822922442,"text":"Another fun read. It was interesting because even as a LDS author there wasn't any religion in this book. I didn't mind the religious aspects of the other books because as a member of The Church of Jesus Christ of Latter-day Saints yes some things define us and set us apart from others just as they did in the books (that's real life, although getting to marry royalty well...). And although religion is an integral part of my life, it isn't only who I am. I was wondering if one of these characters would be introduced to the Gospel because she's a LDS author but it was just an interesting, fun, romance book because in real life not everyone joins the Church. :) I like this author. ","rating":4,"preReleaseBookSource":null,"shelving":{"__ref":"Shelving:{\"creator\":{\"id\":\"kca://profile:goodreads/A96AJXRBFTZCO\"},\"book\":{\"id\":\"kca://book/amzn1.gr.book.v3.3JFAhashUFaPcUC-\"}}"},"likeCount":0,"viewerHasLiked":null,"commentCount":0},"User:988087":{"__typename":"User","legacyId":988087,"imageUrlSquare":"https://i.gr-assets.com/images/S/compressed.photo.goodreads.com/users/1681407426i/988087._UX200_CR0,33,200,200_.jpg","isAuthor":false,"viewerRelationshipStatus":null,"followersCount":343,"textReviewsCount":3626,"name":"Katie (hiding in the pages)","webUrl":"https://www.goodreads.com/user/show/988087-katie-hiding-in-the-pages","contributor":null,"id":988087},"User:kca://profile:goodreads/AV8MD708EK84F":{"__typename":"User","id":"kca://profile:goodreads/AV8MD708EK84F"},"Shelving:{\"creator\":{\"id\":\"kca://profile:goodreads/AV