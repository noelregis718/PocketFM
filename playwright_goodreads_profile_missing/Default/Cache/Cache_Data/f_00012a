pename":"FeaturedKNHCollectionConnection","totalCount":0,"edges":[]},"giveaways":{"__typename":"GiveawaysConnection","edges":[]},"editions":{"__typename":"BooksConnection","webUrl":"https://www.goodreads.com/work/editions/74198486"}},"User:55704599":{"__typename":"User","legacyId":55704599,"imageUrlSquare":"https://i.gr-assets.com/images/S/compressed.photo.goodreads.com/users/1781982627i/55704599._UX200_CR0,15,200,200_.jpg","isAuthor":false,"viewerRelationshipStatus":null,"followersCount":114,"textReviewsCount":1547,"name":"Mara","webUrl":"https://www.goodreads.com/user/show/55704599-mara","contributor":null,"id":55704599},"User:kca://profile:goodreads/AT63H6ZOJBBT6":{"__typename":"User","id":"kca://profile:goodreads/AT63H6ZOJBBT6"},"Book:kca://book/amzn1.gr.book.v3.YkdkB1vQCtermeAh":{"__typename":"Book","id":"kca://book/amzn1.gr.book.v3.YkdkB1vQCtermeAh"},"Shelving:{\"creator\":{\"id\":\"kca://profile:goodreads/AT63H6ZOJBBT6\"},\"book\":{\"id\":\"kca://book/amzn1.gr.book.v3.YkdkB1vQCtermeAh\"}}":{"__typename":"Shelving","creator":{"__ref":"User:kca://profile:goodreads/AT63H6ZOJBBT6","id":"kca://profile:goodreads/AT63H6ZOJBBT6"},"book":{"__ref":"Book:kca://book/amzn1.gr.book.v3.YkdkB1vQCtermeAh","id":"kca://book/amzn1.gr.book.v3.YkdkB1vQCtermeAh"},"shelf":{"__typename":"Shelf","name":"read","displayName":"Read","editable":false,"default":true,"actionType":"add_to_read","sortOrder":2,"webUrl":"https://www.goodreads.com/review/list/55704599?shelf=read"},"taggings":[{"__typename":"Tagging","tag":{"__typename":"Tag","name":"arc-or-for-review","webUrl":"https://www.goodreads.com/review/list/55704599?shelf=arc-or-for-review"}},{"__typename":"Tagging","tag":{"__typename":"Tag","name":"book-launch","webUrl":"https://www.goodreads.com/review/list/55704599?shelf=book-launch"}}],"webUrl":"https://www.goodreads.com/review/show/3049586107"},"Review:kca://review:goodreads/amzn1.gr.review:goodreads.v1.ZxAIllYz7FTXKzJvnJPW0w":{"__typename":"Review","id":"kca://review:goodreads/amzn1.gr.review:goodreads.v1.ZxAIllYz7FTXKzJvnJPW0w","creator":{"__ref":"User:55704599"},"recommendFor":null,"updatedAt":1584914899458,"createdAt":1583308163679,"spoilerStatus":false,"lastRevisionAt":1583308169568,"text":"Traci Hunter Abramson quickly became one of my favorite mystery/suspense authors when I got an e-reader as a gift in 2012. I don't think I've read a book by her that I haven't liked, and this is one I LOVED. This is part of the Royal series, but it can be read as a standalone. I promise you won't be lost if you haven't read the other books. If you have read the others in the series this picks up about a year after Royal Brides. This is my favorite of the all the Royal books--it's got a princess, a handsome and smart hero, a shadowy villain, lots of action, and it takes place on a beautiful Mediterranean island, plus the book has a gorgeous cover. \u003cbr /\u003e\u003cbr /\u003eThis story is told from several viewpoints--Cassie's (Princess Cassandra), Levi's and the villain's. I liked seeing things from the bad guy's perspective--the reader knows what he's doing, but not exactly who he is or how he fits into things. It was another piece in a mysterious puzzle of who wants Princess Cassandra dead and why.\u003cbr /\u003e\u003cbr /\u003eIf my life were ever in danger Levi Marin's the guy I would want protecting me. He's smart, brave and knows his stuff. His first priority was always what was best for Cassie. I thought the romance between them felt believable--not rushed. I felt for Cassie when she had to face her fear of heights because I'm afraid of heights too.\u003cbr /\u003e\u003cbr /\u003eI liked the way the author balanced the budding romance between Cassie and Levi with the action. I thought the plot moved at a steady pace until the exciting conclusion. I got so caught up reading I didn't want to put the book down to do other things. There never seemed to be a good place to stop reading. This is a great addition to my Traci Hunter Abramson book collection.\u003cbr /\u003e\u003cbr /\u003eI received a complimentary copy. All opinions expressed in this review are my own. I loved the book so much I bought a copy for my personal collection.","rating":5,"preReleaseBookSource":null,"shelving":{"__ref":"Shelving:{\"creator\":{\"id\":\"kca://profile:goodreads/AT63H6ZOJBBT6\"},\"book\":{\"id\":\"kca://book/amzn1.gr.book.v3.YkdkB1vQCtermeAh\"}}"},"likeCount":8,"viewerHasLiked":null,"commentCount":2},"User:1934633":{"__typename":"User","legacyId":1934633,"imageUrlSquare":"https://i.gr-assets.com/images/S/compressed.photo.goodreads.com/users/1757338861i/1934633._UY200_CR84,0,200,200_.jpg","isAuthor":false,"viewerRelationshipStatus":null,"followersCount":302,"textReviewsCount":3086,"name":"Aimee ","webUrl":"https://www.goodreads.com/user/show/1934633-aimee","contributor":null,"id":1934633},"User:kca://profile:goodreads/A2UL9J1XR0AFVS":{"__typename":"User","id":"kca://profile:goodreads/A2UL9J1XR0AFVS"},"Shelving:{\"creator\":{\"id\":\"kca://profile:goodreads/A2UL9J1XR0AFVS\"},\"book\":{\"id\":\"kca://book/amzn1.gr.book.v3.3JFAhashUFaPcUC-\"}}":{"__typename":"Shelving","creator":{"__ref":"User:kca://profile:goodreads/A2UL9J1XR0AFVS","id":"kca://profile:goodreads/A2UL9J1XR0AFVS"},"book":{"__ref":"Book:kca://book/amzn1.gr.book.v3.3JFAhashUFaPcUC-","id":"kca://book/amzn1.gr.book.v3.3JFAhashUFaPcUC-"},"shelf":{"__typename":"Shelf","name":"read","displayName":"Read","editable":false,"default":true,"actionType":"add_to_read","sortOrder":2,"webUrl":"https://www.goodreads.com/review/list/1934633?shelf=read"},"taggings":[{"__typename":"Tagging","tag":{"__typename":"Tag","name":"action-suspense","webUrl":"https://www.goodreads.com/review/list/1934633?shelf=action-suspense"}},{"__typename":"Tagging","tag":{"__typename":"Tag","name":"clean-romance","webUrl":"https://www.goodreads.com/review/list/1934633?shelf=clean-romance"}},{"__typename":"Tagging","tag":{"__typename":"Tag","name":"contemporary","webUrl":"https://www.goodreads.com/review/list/1934633?shelf=contemporary"}},{"__typename":"Tagging","tag":{"__typename":"Tag","name":"physical-book-for-review","webUrl":"https://www.goodreads.com/review/list/1934633?shelf=physical-book-for-review"}}],"webUrl":"https://www.goodreads.com/review/show/3122332843"},"Review:kca://review:goodreads/amzn1.gr.review:goodreads.v1.9DYHg0qizVFIweU3ebZdHQ":{"__typename":"Review","id":"kca://review:goodreads/amzn1.gr.review:goodreads.v1.9DYHg0qizVFIweU3ebZdHQ","creator":{"__ref":"User:1934633"},"recommendFor":null,"updatedAt":1583628862341,"createdAt":1583209174276,"spoilerStatus":false,"lastRevisionAt":1583209224019,"text":"Traci Hunter Abramson is one of my favorite go-to authors. She writes several different genres and I enjoy them all. This book is a continuation of her royal books but can easily stand alone. I have to say that I sure love this cover better than the previous ones!\u003cbr /\u003e\u003cbr /\u003eI love the setting of this book and wish I could go somewhere with warm azure waters right now. There is something about imagining the life of a princess in danger and a dashing, strong man to protect her. It definitely feeds those romantic notions that live in my head. Levi is awesome. Trustworthy, brave, smart. All the things a great hero lead should be. Levi and Cassie's relationship feels mature and believable. I enjoyed them both very much.\u003cbr /\u003e\u003cbr /\u003eThe plot in this story has a great build up. Information comes in a steady stream and keeps building until the explosive climax hits. I was interested from beginning to end. This is a clean romantic suspense.\u003cbr /\u003e\u003cbr /\u003eContent: mild violence, mild peril, kissing\u003cbr /\u003e\u003cbr /\u003e- I received a complimentary copy of this book. All opinions expressed are my own.","rating":4,"preReleaseBookSource":null,"shelving":{"__ref":"Shelving:{\"creator\":{\"id\":\"kca://profile:goodreads/A2UL9J1XR0AFVS\"},\"book\":{\"id\":\"kca://book/amzn1.gr.book.v3.3JFAhashUFaPcUC-\"}}"},"likeCount":6,"viewerHasLiked":null,"commentCount":0},"User:864649":{"__typename":"User","legacyId":864649,"imageUrlSquare":"https://i.gr-assets.com/images/S/compressed.photo.goodreads.com/users/1690842885i/864649._UY200_CR0,0,200,200_.jpg","isAuthor":false,"viewerRelationshipStatus":null,"followersCount":211,"textReviewsCount":2241,"name":"Lisa  (Bookworm Lisa)","webUrl":"https://www.goodreads.com/user/show/864649-lisa-bookworm-lisa","contributor":null,"id":864649},"User:kca://profile:goodreads/A2TI7R0VLXJ80S":{"__typename":"User","id":"kca://profile:goodreads/A2TI7R0VLXJ80S"},"Shelving:{\"creator\":{\"id\":\"kca://profile:goodreads/A2TI7R0VLXJ80S\"},\"book\":{\"id\":\"kca://book/amzn1.gr.book.v3.3JFAhashUFaPcUC-\"}}":{"__typename":"Shelving","creator":{"__ref":"User:kca://profile:goodreads/A2TI7R0VLXJ80S","id":"kca://profile:goodreads/A2TI7R0VLXJ80S"},"book":{"__ref":"Book:kca://book/amzn1.gr.book.v3.3JFAhashUFaPcUC-","id":"kca://book/amzn1.gr.book.v3.3JFAhashUFaPcUC-"},"shelf":{"__typename":"Shelf","name":"read","displayName":"Read","editable":false,"default":true,"actionType":"add_to_read","sortOrder":2,"webUrl":"https://www.goodreads.com/review/list/864649?shelf=read"},"taggings":[{"__typename":"Tagging","tag":{"__typename":"Tag","name":"2020","webUrl":"https://www.goodreads.com/review/list/864649?shelf=2020"}},{"__typename":"Tagging","tag":{"__typename":"Tag","name":"clean-read","webUrl":"https://www.goodreads.com/review/list/864649?shelf=clean-read"}},{"__typename":"Tagging","tag":{"__typename":"Tag","name":"contemporary","webUrl":"https://www.goodreads.com/review/list/864649?shelf=contemporary"}},{"__typename":"Tagging","tag":{"__typename":"Tag","name":"received-to-review","webUrl":"https://www.goodreads.com/review/list/864649?shelf=received-to-review"}},{"__typename":"Tagging","tag":{"__typename":"Tag","name":"romance","webUrl":"https://www.goodreads.com/review/list/864649?shelf=romance"}},{"__typename":"Tagging","tag":{"__typename":"Tag","name":"suspense","webUrl":"https://www.goodreads.com/review/list/864649?shelf=suspense"}}],"webUrl":"https://www.goodreads.com/review/show/3129440951"},"Review:kca://review:goodreads/amzn1.gr.review:goodreads.v1.PV94h-hbModkZ0VCTkBjPQ":{"__typename":"Review","id":"kca://review:goodreads/amzn1.gr.review:goodreads.v1.PV94h-hbModkZ0VCTkBjPQ","creator":{"__ref":"User:864649"},"recommendFor":null,"updatedAt":1585004856657,"createdAt":1584828774158,"spoilerStatus":false,"lastRevisionAt":1584830078973,"text":"I really needed this book. It helped to take my mind off of all the uncertainty going on in the world around me. I needed an escape from the news.\u003cbr /\u003e\u003cbr /\u003eThe setting is a kingdom in the Mediterranean. Traci Hunter Abramson describes the scene vividly, it makes e want to visit. For now, I will do so vicariously in the pages of the book. :)\u003cbr /\u003e\u003cbr /\u003eSomeone is trying to kill the Crowned Princess. In an attempt to shelter her from harm, her father sends her to a neighboring kingdom where she meets Levi, an undercover agent for the CIA. Princess Cassandra seems to be serious and withdrawn in the media. Levi soon discovers that it is a public face and that there is a wonderful woman behind the mask. I really liked the characters and that they were well developed. The tame frame of the book is a couple of months, but it didn't feel like a rushed romance\u003cbr /\u003e\u003cbr /\u003eLevi works with others and his resources to track down who is behind the attempt of Cassandra's life. It was easy to be drawn into the story and be right along with Levi as he protects the princess.\u003cbr /\u003e\u003cbr /\u003eTraci Hunter Abramson is one of my favorite suspense authors for a good reason. I know that I will always pick up a well-written book that is entertaining and believable.\u003cbr /\u003e\u003cbr /\u003eSource: I received a complimentary copy. All thoughts and opinions expressed are my own.","rating":4,"preReleaseBookSource":null,"shelving":{"__ref":"Shelving:{\"creator\":{\"id\":\"kca://profile:goodreads/A2TI7R0VLXJ80S\"},\"book\":{\"id\":\"kca://book/amzn1.gr.book.v3.3JFAhashUFaPcUC-\"}}"},"likeCount":6,"viewerHasLiked":null,"commentCount":0},"User:2433931":{"__typename":"User","legacyId":2433931,"imageUrlSquare":"https://i.gr-assets.com/images/S/compressed.photo.goodreads.com/users/1571955186i/2433931.jpg","isAuthor":false,"viewerRelationshipStatus":null,"followersCount":70,"textReviewsCount":2071,"name":"Cathy","webUrl":"https://www.goodreads.com/user/show/2433931-cathy","contributor":null,"id":2433931},"User:kca://profile:goodreads/A3BP9NY4RUT2FL":{"__typename":"User","id":"kca://profile:goodreads/A3BP9NY4RUT2FL"},"Shelving:{\"creator\":{\"id\":\"kca://profile:goodreads/A3BP9NY4RUT2FL\"},\"book\":{\"id\":\"kca://book/amzn1.gr.book.v3.3JFAhashUFaPcUC-\"}}":{"__typename":"Shelving","creator":{"__ref":"User:kca://profile:goodreads/A3BP9NY4RUT2FL","id":"kca://profile:goodreads/A3BP9NY4RUT2FL"},"book":{"__ref":"Book:kca://book/amzn1.gr.book.v3.3JFAhashUFaPcUC-","id":"kca://book/amzn1.gr.book.v3.3JFAhashUFaPcUC-"},"shelf":{"__typename":"Shelf","name":"read","displayName":"Read","editable":false,"default":true,"actionType":"add_to_read","sortOrder":2,"webUrl":"https://www.goodreads.com/review/list/2433931?shelf=read"},"taggings":[],"webUrl":"https://www.goodreads.com/review/show/3227226110"},"Review:kca://review:goodreads/amzn1.gr.review:goodreads.v1.ERLnVsnQiTBKmLZ9azOBbA":{"__typename":"Review","id":"kca://review:goodreads/amzn1.gr.review:goodreads.v1.ERLnVsnQiTBKmLZ9azOBbA","creator":{"__ref":"User:2433931"},"recommendFor":null,"updatedAt":1584236242324,"createdAt":1583955854791,"spoilerStatus":false,"lastRevisionAt":1583955867259,"text":"Traci Hunter Abramson’s suspense books are always my favorites! She has such a way of writing, it just keeps the reader wanting more. There were parts in this one that I wanted to yell at the hero or heroine to stop. But, of course, they couldn’t hear me.\u003cbr /\u003e\u003cbr /\u003eThis book will stand alone just great. However, it will make more sense if you’ve read Royal Target, Royal Secrets and Royal Brides first.\u003cbr /\u003e\u003cbr /\u003eThis one features Princess Cassandra of Sereno. It’s always fun to imagine the life of a princess. And Cassandra has had a great life. But things change rather quickly when it appears that she is the target of an assassin, in her own home! She’s whisked off to a place where her dad thinks she’ll be safe and protected by Levi.\u003cbr /\u003e\u003cbr /\u003eLevi is a great bodyguard and a nice guy. I really enjoyed how quickly Cassie goes from a job to someone he really cares for.\u003cbr /\u003e\u003cbr /\u003eI loved the carefree parts of this book. Where Cassie knows she’s safe and Levi pretends she’s his girlfriend. But the more suspenseful parts are what kept me wanting to read more and more. I’ll just be honest, this author’s books never take me long to read, because I can’t put them down.\u003cbr /\u003e\u003cbr /\u003eIf you love suspense books, you’ll love this one!\u003cbr /\u003e\u003cbr /\u003eI was sent a copy of Royal Heir as a gift from the publisher. All opinions are my own.","rating":5,"preReleaseBookSource":null,"shelving":{"__ref":"Shelving:{\"creator\":{\"id\":\"kca://profile:goodreads/A3BP9NY4RUT2FL\"},\"book\":{\"id\":\"kca://book/amzn1.gr.book.v3.3JFAhashUFaPcUC-\"}}"},"likeCount":4,"viewerHasLiked":null,"commentCount":2},"User:2623915":{"__typename":"User","legacyId":2623915,"imageUrlSquare":"https://i.gr-assets.com/images/S/compressed.photo.goodreads.com/users/1584656659i/2623915._UX200_CR0,45,200,200_.jpg","isAuthor":false,"viewerRelationshipStatus":null,"followersCount":18,"textReviewsCount":2963,"name":"Patricia","webUrl":"https://www.goodreads.com/user/show/2623915-patricia","contributor":null,"id":2623915},"User:kca://profile:goodreads/A3B9DZOUIS26OT":{"__typename":"User","id":"kca://profile:goodreads/A3B9DZOUIS26OT"},"Shelving:{\"creator\":{\"id\":\"kca://profile:goodreads/A3B9DZOUIS26OT\"},\"book\":{\"id\":\"kca://book/amzn1.gr.book.v3.3JFAhashUFaPcUC-\"}}":{"__typename":"Shelving","creator":{"__ref":"User:kca://profile:goodreads/A3B9DZOUIS26OT","id":"kca://profile:goodreads/A3B9DZOUIS26OT"},"book":{"__ref":"Book:kca://book/amzn1.gr.book.v3.3JFAhashUFaPcUC-","id":"kca://book/amzn1.gr.book.v3.3JFAhashUFaPcUC-"},"shelf":{"__typename":"Shelf","name":"read","displayName":"Read","editable":false,"default":true,"actionType":"add_to_read","sortOrder":2,"webUrl":"https://www.goodreads.com/review/list/2623915?shelf=read"},"taggings":[],"webUrl":"https://www.goodreads.com/review/show/3168020472"},"Review:kca://review:goodreads/amzn1.gr.review:goodreads.v1.Feyf5zj7yVdmSK8OBH7Ssw":{"__typename":"Review","id":"kca://review:goodreads/amzn1.gr.review:goodreads.v1.Feyf5zj7yVdmSK8OBH7Ssw","creator":{"__ref":"User:2623915"},"recommendFor":null,"updatedAt":1656789710465,"createdAt":1585806924981,"spoilerStatus":false,"lastRevisionAt":1599762927087,"text":"This was a nice story. I feel bad not giving 5 stars. For one, I don’t like getting inside the bad guy’s head. Second, for some reason, I kept scan-reading which normally is 2 stars. But this had more going on. This was just so mild-mannered.\u003cbr /\u003e\u003cbr /\u003e**Next morning.** I woke up thinking about this book and why it wasn't five stars. I am a huge fan of Abramson and I have read pretty much everything she's written. She is one of the bright lights of LDS fiction. I was looking forward to this book. Sometimes that can set me up to be disappointed but I don't think that was it this time. I have tired of certain tropes within the romance genre and, unfortunately, dating royalty is one of them, so I think that tempered any unrealistic expectations. However, I also don't think that bias had an effect on the star rating.\u003cbr /\u003e\u003cbr /\u003eMy thoughts this morning, with particular clarity given that I had awakened from deep sleep to that clarity, focused on the author's inclusion of Julian's point of view. Normally, my dislike of reading the bad guy's POV is that he is creepy. That wasn't the case here. Julian was a garden-variety bad guy. The real problem was that his inclusion totally wiped out any mystery and any suspense in the plot. I am not even going to list my discussion here as a spoiler because the inclusion of Julian's POV was a spoiler. Who shot at Cassie? Well, we knew that immediately--someone hired by Julian. Why did someone shoot at Cassie? Well, immediately it was revealed what Julian's motivations were. Why was there a theft accompanying the shooting? Well, we knew that, too. What was going to happen next? We knew that, too. All that sleuthing by Levi at Garrett's home was just a form of showing off Levi's extensive contacts or prowess--because we knew everything before he did. We as the reader had nothing to gain by wading through all that. There was nothing he discovered that gave us any sort of \"Ah-ha!\" moment--we already knew what he would find--over and over and over. This is the same for the ending (and you can choose not to read the rest of this review) because you knew Julian was there at the castle and you knew why he was there and you knew how he got in and you knew who was with him. And, and, and. The fight was just a series of mini-skirmishes, not one big blow out. Levi and Cassie merely chatted behind a rock. I had no worries that they would be caught because they were chatting full-voice behind those rocks. \u003cbr /\u003e\u003cbr /\u003eThen there was the romance that wasn't very romantic. For the first . . . what . . . half of the book, I liked both characters adequately but there was no spark and no attraction until there was the almost inadvertent romance. Yes, I knew I was reading a book labeled \"romance\" but did Levi and Cassie know they were in a romantic novel? I couldn't tell it, not until that mid-point when they did somehow veer in that direction. And even after that, their romance was so calm and business-like that it just wasn't romantic. The romance was like a people mover at an airport. At the airport, you step on the people mover and you stand there while it moves you along to the end. No curves or twists, no ups or downs, it just keeps moving steadily to the end. I kept feeling like I was reading about an already married couple rather than the discovery of new love.\u003cbr /\u003e\u003cbr /\u003eI believe these two reasons (Julian's POV and the staid romance) were why I scan-read. Truthfully, scan-reading is normally a two-star rating--automatically--but I just couldn't do that to writing royalty (Abramson).","rating":3,"preReleaseBookSource":null,"shelving":{"__ref":"Shelving:{\"creator\":{\"id\":\"kca://profile:goodreads/A3B9DZOUIS26OT\"},\"book\":{\"id\":\"kca://book/amzn1.gr.book.v3.3JFAhashUFaPcUC-\"}}"},"likeCount":3,"viewerHasLiked":null,"commentCount":0},"User:15866082":{"__typename":"User","legacyId":15866082,"imageUrlSquare":"https://i.gr-assets.com/images/S/compressed.photo.goodreads.com/users/1761801507i/15866082._UX200_CR0,0,200,200_.jpg","isAuthor":false,"viewerRelationshipStatus":null,"followersCount":135,"textReviewsCount":1098,"name":"Sydney","webUrl":"https://www.goodreads.com/user/show/15866082-sydney","contributor":null,"id":15866082},"User:kca://profile:goodreads/A1N0RQSCO952US":{"__typename":"User","id":"kca://profile:goodreads/A1N0RQSCO952US"},"Shelving:{\"creator\":{\"id\":\"kca://profile:goodreads/A1N0RQSCO952US\"},\"book\":{\"id\":\"kca://book/amzn1.gr.book.v3.3JFAhashUFaPcUC-\"}}":{"__typename":"Shelving","creator":{"__ref":"User:kca://profile:goodreads/A1N0RQSCO952US","id":"kca://profile:goodreads/A1N0RQSCO952US"},"book":{"__ref":"Book:kca://book/amzn1.gr.book.v3.3JFAhashUFaPcUC-","id":"kca://book/amzn1.gr.book.v3.3JFAhashUFaPcUC-"},"shelf":{"__typename":"Shelf","name":"read","displayName":"Read","editable":false,"default":true,"actionType":"add_to_read","sortOrder":2,"webUrl":"htt