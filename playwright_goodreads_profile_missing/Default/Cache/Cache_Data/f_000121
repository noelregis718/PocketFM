_typename":"Tagging","tag":{"__typename":"Tag","name":"cute-adorable","webUrl":"https://www.goodreads.com/review/list/81913577?shelf=cute-adorable"}},{"__typename":"Tagging","tag":{"__typename":"Tag","name":"dark-rom_bully-stalker_anti-etc","webUrl":"https://www.goodreads.com/review/list/81913577?shelf=dark-rom_bully-stalker_anti-etc"}},{"__typename":"Tagging","tag":{"__typename":"Tag","name":"docs-medical_mental_disability","webUrl":"https://www.goodreads.com/review/list/81913577?shelf=docs-medical_mental_disability"}}],"webUrl":"https://www.goodreads.com/review/show/5577211077"},"Review:kca://review:goodreads/amzn1.gr.review:goodreads.v1.C3go3O4yeVjbSB3USQjJiQ":{"__typename":"Review","id":"kca://review:goodreads/amzn1.gr.review:goodreads.v1.C3go3O4yeVjbSB3USQjJiQ","creator":{"__ref":"User:81913577"},"recommendFor":null,"updatedAt":1686823569335,"createdAt":1686675803671,"spoilerStatus":false,"lastRevisionAt":1686755337231,"text":"\u003cb\u003eI had so much fun!! [Audiobook Review]\u003c/b\u003e\u003cbr /\u003e\"Forbidden Warlords in Love\" boxset by Alison Aimes consist of 3 Darkish, Fated Mates, Omegaverse novellas with an insta-feel yet the romance feels genuine \u0026amp; not rushed, there's also some action-suspense components with gives them an edge, \u0026amp; a sweet HEA! I've read all 3 seperately before listening and I wholeheartedly recommend them! They're in the wider Alphaverse by Alison but can be read/listened standalone. Thank you so much to Alison for my audiobook copy 🥰.\u003cbr /\u003e\u003cbr /\u003eMagnus, the exiled alpha king looking for revenge meets his match in Amora, an omega with a volatile gift who had only ever wanted a place to belong in \"Forbidden Flame\".\u003cbr /\u003ePavel (Mag's subordinate), an outlaw with a haunted past finds his angel Ari when she literally crashes into him from above, Have they really lived different lives or do they have the same lawless heart? Find in \"Princess Claimed\". (These two books are set in the forbidden sector!)\u003cbr /\u003eSee the beginning of this Alphaverse in Prequel \"War Prize of the Beast\" as Cheim saves the omega-in-distress Anara \u0026amp; takes her as his prize!\u003cbr /\u003e\u003cbr /\u003eThe audiobook narration is by duet Samantha Brentmoor, JF Harding is so amazing. Their voices are smooth, pleasant \u0026amp; easy to understand. I especially LOVED how Harding narrated the side characters \u0026amp; how both of them made those distinguishable. They didn't sound flat and had appropriate emotions for all scenes. I feel so happy 🥰. Definitely recommend!\u003cbr /\u003e\u003cbr /\u003e✨Audiobook+Story ratings:\u003cbr /\u003e\u003cbr /\u003e1) The characters: 5/5\u003cbr /\u003e2) The feels: 😃😅😣🤯🤩😘😉🧐😍😏😬😍\u003cbr /\u003e3) Story conflicts \u0026amp; creativity: 4.5/5\u003cbr /\u003e4) World development: 5/5\u003cbr /\u003e5) Relationship: 5/5\u003cbr /\u003e6) Sexy/Steamy times: 3.5/5 (especially Princess Claimed, that's the hottest!)\u003cbr /\u003e7) Levels: Mildly Low Angst, surprisingly adorbs, Mild Dark\u003cbr /\u003e8) POV \u0026amp; Writing style: 3rd Person, Dual POV - 4.7/5\u003cbr /\u003e9) Flow \u0026amp; Enjoy: 5/5\u003cbr /\u003e10) Voice acting: 5/5\u003cbr /\u003e\u003cbr /\u003e** #arcHonestReview #AllViewsAreMyOwn **\u003cbr /\u003e\u003cbr /\u003e\u003ca href=\"https://m.facebook.com/ToonasaLovesBooks/\" rel=\"nofollow noopener\"\u003eFB Page\u003c/a\u003e | \u003ca href=\"https://www.instagram.com/toonasa.loves.books/\" rel=\"nofollow noopener\"\u003eInstagram\u003c/a\u003e | \u003ca href=\"https://www.bookbub.com/profile/89245731\" rel=\"nofollow noopener\"\u003eBookbub\u003c/a\u003e | \u003ca href=\"https://m.facebook.com/groups/164936121697459/\" rel=\"nofollow noopener\"\u003eFB group\u003c/a\u003e","rating":5,"preReleaseBookSource":null,"shelving":{"__ref":"Shelving:{\"creator\":{\"id\":\"kca://profile:goodreads/A3JLDEK2WKLYKW\"},\"book\":{\"id\":\"kca://book/amzn1.gr.book.v3.GCrlj0liGt4XSEGK\"}}"},"likeCount":3,"viewerHasLiked":null,"commentCount":0},"User:23824163":{"__typename":"User","legacyId":23824163,"imageUrlSquare":"https://i.gr-assets.com/images/S/compressed.photo.goodreads.com/users/1594682098i/23824163._UX200_CR0,10,200,200_.jpg","isAuthor":false,"viewerRelationshipStatus":null,"followersCount":22,"textReviewsCount":3497,"name":"Bette","webUrl":"https://www.goodreads.com/user/show/23824163-bette","contributor":null,"id":23824163},"User:kca://profile:goodreads/A13AX9B29SDDA5":{"__typename":"User","id":"kca://profile:goodreads/A13AX9B29SDDA5"},"Shelving:{\"creator\":{\"id\":\"kca://profile:goodreads/A13AX9B29SDDA5\"},\"book\":{\"id\":\"kca://book/amzn1.gr.book.v3.GCrlj0liGt4XSEGK\"}}":{"__typename":"Shelving","creator":{"__ref":"User:kca://profile:goodreads/A13AX9B29SDDA5","id":"kca://profile:goodreads/A13AX9B29SDDA5"},"book":{"__ref":"Book:kca://book/amzn1.gr.book.v3.GCrlj0liGt4XSEGK","id":"kca://book/amzn1.gr.book.v3.GCrlj0liGt4XSEGK"},"shelf":{"__typename":"Shelf","name":"read","displayName":"Read","editable":false,"default":true,"actionType":"add_to_read","sortOrder":2,"webUrl":"https://www.goodreads.com/review/list/23824163?shelf=read"},"taggings":[],"webUrl":"https://www.goodreads.com/review/show/5564967918"},"Review:kca://review:goodreads/amzn1.gr.review:goodreads.v1.aSQtWR84wGtKWtmvLBp6BQ":{"__typename":"Review","id":"kca://review:goodreads/amzn1.gr.review:goodreads.v1.aSQtWR84wGtKWtmvLBp6BQ","creator":{"__ref":"User:23824163"},"recommendFor":null,"updatedAt":1685113795037,"createdAt":1684697270593,"spoilerStatus":false,"lastRevisionAt":1684697298432,"text":"Steamy, Fascinating \u0026amp; Out of this World! Great Story \u0026amp; Narration🎧\u003cbr /\u003e\u003cbr /\u003eForbidden Warlords in Love: A Dark Fated-Mated Romance Box Set\u003cbr /\u003eRuthless Warlords Series Standalones\u003cbr /\u003eBy: Alison Aimes\u003cbr /\u003eNarrated by: J.F. Harding, Samantha Brentmoor\u003cbr /\u003e\u003cbr /\u003eThis great box set contains three amazing and out of this world novellas set in Alison Aimes “Ruthless Warlords” series, each story features different lead characters and stands on its own. Each one is just as fascinating as the other, starting with “Forbidden Flame” an alpha crime boss exiled to the forbidden sector is plotting his revenge and he finds his way in, by delivering a package, a package he was not supposed to see, but then the contents of it moves, so he had to check what it was and surprised at what he finds, not just a fiery omega, someone his enemy wants as a tool, but she is his mate. The second story, Princess Claimed”, an ex-convict exiled to the forbidden sector runs a shipping business with a partner who drops by occasionally, since he prefers to be a loner. His life changes when an angel falls from the sky and into his arms. She has no memory of who she was, where she came from or how she got there. He knows she is his mate, but he still tries to find out who she is and then memories come back to her, and she fears she will put him in danger. Can their relationship even be? The third story, “War Prize of the Beast” is the most barbaric of the three, the beast found his prey, but the prey turns into something much more, something sweet and delicious, his mate. I loved the originality of these stories, they are fascinating and imaginative, and have plenty of drama, action, twists and turns, and steam. Alison Aimes, thank you for these amazing stories and the fascinating omega verse. \u003cbr /\u003e\u003cbr /\u003e🎧📚🎧 And for the fantastic narration, J.F. Harding and Samantha Brentmoor did an amazing job bringing these characters to life and did so with a complete understanding of who they were portraying, giving each their own distinct voice and personality. I loved how they took each role and made it their own and they were believable in every role they played. They set the perfect tone for each story, captured all the characters emotions and projected them into their performance. These entertaining storytellers are a versatile voice artists and a pleasure to listen to. Thank you for another amazing listen. ","rating":5,"preReleaseBookSource":null,"shelving":{"__ref":"Shelving:{\"creator\":{\"id\":\"kca://profile:goodreads/A13AX9B29SDDA5\"},\"book\":{\"id\":\"kca://book/amzn1.gr.book.v3.GCrlj0liGt4XSEGK\"}}"},"likeCount":1,"viewerHasLiked":null,"commentCount":0},"User:19986299":{"__typename":"User","legacyId":19986299,"imageUrlSquare":"https://i.gr-assets.com/images/S/compressed.photo.goodreads.com/users/1563989665i/19986299.jpg","isAuthor":false,"viewerRelationshipStatus":null,"followersCount":15,"textReviewsCount":288,"name":"Kristi - ReetzyTheBookNerd","webUrl":"https://www.goodreads.com/user/show/19986299-kristi---reetzythebooknerd","contributor":null,"id":19986299},"User:kca://profile:goodreads/AA4RBSGXNS4U3":{"__typename":"User","id":"kca://profile:goodreads/AA4RBSGXNS4U3"},"Shelving:{\"creator\":{\"id\":\"kca://profile:goodreads/AA4RBSGXNS4U3\"},\"book\":{\"id\":\"kca://book/amzn1.gr.book.v3.GCrlj0liGt4XSEGK\"}}":{"__typename":"Shelving","creator":{"__ref":"User:kca://profile:goodreads/AA4RBSGXNS4U3","id":"kca://profile:goodreads/AA4RBSGXNS4U3"},"book":{"__ref":"Book:kca://book/amzn1.gr.book.v3.GCrlj0liGt4XSEGK","id":"kca://book/amzn1.gr.book.v3.GCrlj0liGt4XSEGK"},"shelf":{"__typename":"Shelf","name":"read","displayName":"Read","editable":false,"default":true,"actionType":"add_to_read","sortOrder":2,"webUrl":"https://www.goodreads.com/review/list/19986299?shelf=read"},"taggings":[{"__typename":"Tagging","tag":{"__typename":"Tag","name":"books-of-2023","webUrl":"https://www.goodreads.com/review/list/19986299?shelf=books-of-2023"}}],"webUrl":"https://www.goodreads.com/review/show/5552686448"},"Review:kca://review:goodreads/amzn1.gr.review:goodreads.v1.rSlps0VQdyBt-TxIR-sC-Q":{"__typename":"Review","id":"kca://review:goodreads/amzn1.gr.review:goodreads.v1.rSlps0VQdyBt-TxIR-sC-Q","creator":{"__ref":"User:19986299"},"recommendFor":null,"updatedAt":1684528752141,"createdAt":1684186647640,"spoilerStatus":false,"lastRevisionAt":1684188236201,"text":"(4.5 stars)\u003cbr /\u003e\u003cbr /\u003eDark romance… Check\u003cbr /\u003eMafia romance... check\u003cbr /\u003eSci-fi romance… check\u003cbr /\u003e\u003cbr /\u003eIf you are a fan of one or more of those then you will love with the three alpha-holes and their forbidden mates in \u003ci\u003e Forbidden Warlords in Love \u003c/i\u003e by Alison Aimes. This box set of novellas contains \u003ci\u003e Forbidden Flame, Princess Claimed, and War Prize of the Beast. \u003c/i\u003e\u003cbr /\u003e\u003cbr /\u003e\u003ci\u003e Forbidden Flame \u003c/i\u003e – Magnus has one job to do, deliver a volatile package and to NOT open the bag. But when it begins to move, his curiosity gets the better of him and he opens it. He never expected to come face to face with her or to have his baser instincts kick in. Before she can escape, Amora is unpacked and finds herself being claimed by a large, ferocious alpha. \u003cbr /\u003e\u003ci\u003e Princess Claimed \u003c/i\u003e– A princess is on the run with no memory of who she is and in need of help. He is a exile alpha who learned it’s much safer to help himself and himself only. That is, until his fated mate falls into his arms, quite literally. Now, he will do anything to possess and protect what’s his. \u003cbr /\u003e\u003ci\u003e War Prize of the Beast \u003c/i\u003e – One is soft, little, and prey while the other is the apex predator, big, and fierce. One is designed to conquer, kill, and to be an alpha. The other, to run, hide, and be killed. When the most feared creature captures its prize, he is expecting his usual conquest, but what he gets is the furthest from the truth. \u003cbr /\u003e\u003cbr /\u003eThis box set is narrated by the fantastic duo Samantha Brentmoor and J.F. Harding. These two narrators need more narrations together. Samantha brought such life, strength, and a side of vulnerability to all three of the omegas in these inter-galactic stories. J.F. Harding as these three ferocious alpha males is the dark to Brentmoor’s light. He is everything you want in a alpha-hole mate, he is deep and growly and yet he is charming and one hundred percent swoon-worthy. Again, these two narrators need more audiobooks together.","rating":4,"preReleaseBookSource":null,"shelving":{"__ref":"Shelving:{\"creator\":{\"id\":\"kca://profile:goodreads/AA4RBSGXNS4U3\"},\"book\":{\"id\":\"kca://book/amzn1.gr.book.v3.GCrlj0liGt4XSEGK\"}}"},"likeCount":1,"viewerHasLiked":null,"commentCount":0},"User:115144039":{"__typename":"User","legacyId":115144039,"imageUrlSquare":"https://i.gr-assets.com/images/S/compressed.photo.goodreads.com/users/1632699089i/115144039._UX200_CR0,0,200,200_.jpg","isAuthor":false,"viewerRelationshipStatus":null,"followersCount":0,"textReviewsCount":56,"name":"April - Just One More Chapter","webUrl":"https://www.goodreads.com/user/show/115144039-april---just-one-more-chapter","contributor":null,"id":115144039},"User:kca://profile:goodreads/A2PR61AKS3ABW7":{"__typename":"User","id":"kca://profile:goodreads/A2PR61AKS3ABW7"},"Shelving:{\"creator\":{\"id\":\"kca://profile:goodreads/A2PR61AKS3ABW7\"},\"book\":{\"id\":\"kca://book/amzn1.gr.book.v3.GCrlj0liGt4XSEGK\"}}":{"__typename":"Shelving","creator":{"__ref":"User:kca://profile:goodreads/A2PR61AKS3ABW7","id":"kca://profile:goodreads/A2PR61AKS3ABW7"},"book":{"__ref":"Book:kca://book/amzn1.gr.book.v3.GCrlj0liGt4XSEGK","id":"kca://book/amzn1.gr.book.v3.GCrlj0liGt4XSEGK"},"shelf":{"__typename":"Shelf","name":"read","displayName":"Read","editable":false,"default":true,"actionType":"add_to_read","sortOrder":2,"webUrl":"https://www.goodreads.com/review/list/115144039?shelf=read"},"taggings":[],"webUrl":"https://www.goodreads.com/review/show/5577353796"},"Review:kca://review:goodreads/amzn1.gr.review:goodreads.v1.Fh1SxU4xLAau8RK-MEGlVw":{"__typename":"Review","id":"kca://review:goodreads/amzn1.gr.review:goodreads.v1.Fh1SxU4xLAau8RK-MEGlVw","creator":{"__ref":"User:115144039"},"recommendFor":null,"updatedAt":1685231760574,"createdAt":1685197430586,"spoilerStatus":false,"lastRevisionAt":1685198080664,"text":"Forbidden Warlords In Love 6-8\u003cbr /\u003eForbidden Flame Princess Claimed and War Prize if the Beast\u003cbr /\u003eBy Allison Aimes\u003cbr /\u003eNarrated by Samantha Brentmoor and J. F. Harding \u003cbr /\u003eIf you’re a fan of Mafia romance, Forbidden romance or Dark romance you will love these novellas. I love a good boxed set and even though I hadn’t listened to 1-5 it wasn’t hard to figure out what’s going on. This boxed set contains Forbidden Flame, Princess Claimed and War Prize of the Beast. I’m not going to break them down individually. I’m just going to say narrators Samantha Brentmoor and J. F. Harding are outstanding as always! Allison Aimes brings us three novellas that are a great listen! Full of action, 🔥🔥🔥and so dark. These three things make for some of my favorite listens. You will not regret listening to them and I look forward to going back to the beginning and listening to the entire collection. ","rating":4,"preReleaseBookSource":null,"shelving":{"__ref":"Shelving:{\"creator\":{\"id\":\"kca://profile:goodreads/A2PR61AKS3ABW7\"},\"book\":{\"id\":\"kca://book/amzn1.gr.book.v3.GCrlj0liGt4XSEGK\"}}"},"likeCount":1,"viewerHasLiked":null,"commentCount":0},"User:25653487":{"__typename":"User","legacyId":25653487,"imageUrlSquare":"https://i.gr-assets.com/images/S/compressed.photo.goodreads.com/users/1403508931i/25653487._UX200_CR0,49,200,200_.jpg","isAuthor":false,"viewerRelationshipStatus":null,"followersCount":3,"textReviewsCount":101,"name":"Caroline","webUrl":"https://www.goodreads.com/user/show/25653487-caroline","contributor":null,"id":25653487},"User:kca://profile:goodreads/A1LZVYFFP8VIN2":{"__typename":"User","id":"kca://profile:goodreads/A1LZVYFFP8VIN2"},"Book:kca://book/amzn1.gr.book.v3.9quM2irob3bELAWr":{"__typename":"Book","id":"kca://book/amzn1.gr.book.v3.9quM2irob3bELAWr"},"Shelving:{\"creator\":{\"id\":\"kca://profile:goodreads/A1LZVYFFP8VIN2\"},\"book\":{\"id\":\"kca://book/amzn1.gr.book.v3.9quM2irob3bELAWr\"}}":{"__typename":"Shelving","creator":{"__ref":"User:kca://profile:goodreads/A1LZVYFFP8VIN2","id":"kca://profile:goodreads/A1LZVYFFP8VIN2"},"book":{"__ref":"Book:kca://book/amzn1.gr.book.v3.9quM2irob3bELAWr","id":"kca://book/amzn1.gr.book.v3.9quM2irob3bELAWr"},"shelf":{"__typename":"Shelf","name":"read","displayName":"Read","editable":false,"default":true,"actionType":"add_to_read","sortOrder":2,"webUrl":"https://www.goodreads.com/review/list/25653487?shelf=read"},"taggings":[{"__typename":"Tagging","tag":{"__typename":"Tag","name":"alpha-ftw","webUrl":"https://www.goodreads.com/review/list/25653487?shelf=alpha-ftw"}}],"webUrl":"https://www.goodreads.com/review/show/5575089620"},"Review:kca://review:goodreads/amzn1.gr.review:goodreads.v2.2023052609.5fd26ce4-f54d-420c-9bbd-d595b49cb46a":{"__typename":"Review","id":"kca://review:goodreads/amzn1.gr.review:goodreads.v2.2023052609.5fd26ce4-f54d-420c-9bbd-d595b49cb46a","creator":{"__ref":"User:25653487"},"recommendFor":null,"updatedAt":1685094275581,"createdAt":1685092875160,"spoilerStatus":false,"lastRevisionAt":1685094275426,"text":"**Audiobook Review** \u003cbr /\u003e\u003cbr /\u003eForbidden Warlords in Love is a captivating collection of three steamy enemies-to-lovers forced-proximity romances that will leave listeners breathless. Each story within the anthology showcases the intense and passionate journey of a pair of characters bound by fate, fighting against the odds to find love and redemption.\u003cbr /\u003e\u003cbr /\u003eIn \"Princess Claimed,\" you are introduced to an intriguing world of danger and suspense. The alpha crime boss, Magnus Avitus, is a complex and compelling character driven by a thirst for revenge. When he crosses paths with Amora Rose, an omega with a secret past, their lives collide in a way that neither of them expected. The chemistry between Magnus and Amora is electric, and the author skillfully weaves together a tale of intrigue, desire, and unexpected twists.\u003cbr /\u003e\u003cbr /\u003e\"War Prize of the Beast\" takes you on a thrilling journey filled with raw emotions and intense passion. The apex predator, a formidable and fearsome beast, captures a war prize expecting a conquest but discovers something entirely different. The power dynamics and vulnerability between the characters create a compelling and sizzling dynamic that keeps readers hooked until the very end.\u003cbr /\u003e\u003cbr /\u003eThe anthology concludes with \"Forbidden Love\" The juxtaposition of size and strength between the characters adds an extra layer of tension to the narrative. As the characters battle their own destinies, the forbidden love that blooms between them becomes a beacon of hope. This story explores themes of redemption, acceptance, and the transformative power of love.\u003cbr /\u003e\u003cbr /\u003eThroughout the collection, the author skillfully balances romance, action, and suspense, keeping readers on the edge of their seats. The writing is immersive and evocative, painting vivid scenes that transport readers into the heart of the story. The chemistry between the characters is palpable, creating intense and steamy love scenes that will make readers blush.\u003cbr /\u003e\u003cbr /\u003eThe narrators JF Harding and Samantha Brentmoor were outstanding. They bought the characters to life with plenty of emotion and created both tension and passion with their performance.\u003cbr /\u003e\u003cbr /\u003eForbidden Warlords in Love is a must-listen for fans of dark romance, fated mates, and enemies-to-lovers tropes. The anthology seamlessly combines these elements, delivering a thrilling and passionate listening experience. The author's ability to create complex characters and intricate plotlines is truly commendable and fantastic narration is the cherry on top.\u003cbr /\u003e\u003cbr /\u003e\u003cbr /\u003e","rating":4,"preReleaseBookSource":null,"shelving":{"__ref":"Shelving:{\"creator\":{\"id\":\"kca://profile:goodreads/A1LZVYFFP8VIN2\"},\"book\":{\"id\":\"kca://book/amzn1.gr.book.v3.9quM2irob3bELAWr\"}}"},"likeCount":1,"viewerHasLiked":null,"commentCount":0},"Shelving:{\"creator\":{\"id\":\"kca://profile:goodreads/A13AX9B29SDDA5\"},\"book\":{\"id\":\"kca://book/amzn1.gr.book.v3.9quM2irob3bELAWr\"}}":{"__typename":"Shelving","creator":{"__ref":"User:kca://profile:goodreads/A13AX9B29SDDA5","id":"kca://profile:goodreads/A13AX9B29SDDA5"},"book":{"__ref":"Book:kca://book/amzn1.gr.book.v3.9quM2irob3bELAWr","id":"kca://book/amzn1.gr.book.v3.9quM2irob3bELAWr"},"shelf":{"__typename":"Shelf","name":"read","displayName":"Read","editable":false,"default":true,"actionType":"add_to_read","sortOrder":2,"webUrl":"https://www.goodreads.com/review/list/23824163?shelf=read"},"taggings":[],"webUrl":"https://www.goodreads.com/review/show/5528585297"},"Review:kca://review:goodreads/amzn1.gr.review:goodreads.v1.raWcUz57ZW0Vh-vueLN0LQ":{"__typename":"Review","id":"kca://review:goodreads/amzn1.gr.review:goodreads.v1.raWcUz57ZW0Vh-vueLN0LQ","creator":{"__ref":"User:23824163"},"recommendFor":null,"updatedAt":1684729073042,"createdAt":1684697927126,"spoilerStatus":false,"lastRevisionAt":1684698010690,"text":"Steamy, Fascinating \u0026amp; Out of this World! Great Story \u0026amp; Narration🎧\u003cbr /\u003e\u003cbr /\u003eForbidden Warlords in Love: A Dark Fated-Mated Romance Box Set\u003cbr /\u003eRuthless Warlords Series Standalones\u003cbr /\u003eBy: Alison Aimes\u003cbr /\u003eNarrated by: J.F. Harding, Samantha Brentmoor\u003cbr /\u003e\u003cbr /\u003eThis great box set contains three amazing and out of this world novellas set in Alison Aimes “Ruthless Warlords” series, each story features different lead characters and stands on its own. Each one is just as fascinating as the other, starting with “Forbidden Flame” an alpha crime boss exiled to the forbidden sector is plotting his revenge and he finds his way in, by delivering a package, a package he was not supposed to see, but then the contents of it moves, so he had to check what it was and surprised at what he finds, not just a fiery omega, someone his enemy wants as a tool, but she is his mate. The second story, Princess Claimed”, an ex-convict exiled to the forbidden sector runs a shipping business with a partner who drops by occasionally, since he prefers to be a loner. His life changes when an angel falls from the sky and into his arms. She has no memory of who she was, where she came from or how she got there. He knows she is his mate, but he still tries to find out who she is and then memories come back to her, and she fears she will put him in danger. Can their relationship even be? The third story, “War Prize of the Beast” is the most barbaric of the three, the beast found his prey, but the prey turns into something much more, something sweet and delicious, his mate. I loved the originality of these stories, they are fascinating and imaginative, and have plenty of drama, action, twists and turns, and steam. Alison Aimes, thank you for these amazing stories and the fascinating omega verse. \u003cbr /\u003e\u003cbr /\u003e🎧📚🎧 And for the fantastic narration, J.F. Harding and Samantha Brentmoor did an amazing job bringing these characters to life and did so with a complete understanding of who they were portraying, giving each their own distinct voice and personality. I loved how they took each role and made it their own and they were believable in every role they played. They set the perfect tone for each story, captured all the characters emotions and projected them into their performance. These entertaining storytellers are a versatile voice artists and a pleasure to listen to. Thank you for another amazing listen. ","rating":5,"preReleaseBookSource":null,"shelving":{"__ref":"Shelving:{\"creator\":{\"id\":\"kca://profile:goodreads/A13AX9B29SDDA5\"},\"book\":{\"id\":\"kca://book/amzn1.gr.book.v3.9quM2irob3bELAWr\"}}"},"likeCount":0,"viewerHasLiked":null,"commentCount":0},"User:90133321":{"__typename":"User","legacyId":90133321,"imageUrlSquare":"https://i.gr-assets.com/images/S/compressed.photo.goodreads.com/users/1652996591i/90133321._UX200_CR0,0,200,200_.jpg","isAuthor":false,"viewerRelationshipStatus":null,"followersCount":5,"textReviewsCount":684,"name":"Tiffany Barnett","webUrl":"https://www.goodreads.com/user/show/90133321-tiffany-barnett","contributor":null,"id":90133321},"User:kca://profile:goodreads/A106SE6MCCNOJQ":{"__typename":"User","id":"kca://profile:goodreads/A106SE6MCCNOJQ"},"Shelving:{\"creator\":{\"id\":\"kca://profile:goodreads/A106SE6MCCNOJQ\"},\"book\":{\"id\":\"kca://book/amzn1.gr.book.v3.GCrlj0liGt4XSEGK\"}}":{"__typename":"Shelving","creator":{"__ref":"User:kca://profile:goodreads/A106SE6MCCNOJQ","id":"kca://profile:goodreads/A106SE6MCCNOJQ"},"book":{"__ref":"Book:kca://book/amzn1.gr.book.v3.GCrlj0liGt4XSEGK","id":"kca://book/amzn1.gr.book.v3.GCrlj0liGt4XSEGK"},"shelf":{"__typename":"Shelf","name":"read","displayName":"Read","editable":false,"default":true,"actionType":"add_to_read","sortOrder":2,"webUrl":"https://www.goodreads.com/review/list/90133321?shelf=read"},"taggings":[{"__typename":"Tagging","tag":{"__typename":"Tag","name":"2023-reads","webUrl":"https://www.goodreads.com/review/list/90133321?shelf=2023-reads"}},{"__typename":"Tagging","tag":{"__typename":"Tag","name":"jp","webUrl":"https://www.goodreads.com/review/list/90133321?shelf=jp"}},{"__typename":"Tagging","tag":{"__typename":"Tag","name":"pnr","webUrl":"https://www.goodreads.com/review/list/90133321?shelf=pnr"}}],"webUrl":"https://www.goodreads.com/review/show/5560938582"},"Review:kca://review:goodreads/amzn1.gr.review:goodreads.v1.piA-EC6HS1sGS5A05EI4uA":{"__typename":"Review","id":"kca://review:goodreads/amzn1.gr.review:goodreads.v1.piA-EC6HS1sGS5A05EI4uA","creator":{"__ref":"User:90133321"},"recommendFor":null,"updatedAt":1684526342052,"createdAt":1684524010153,"spoilerStatus":false,"lastRevisionAt":1684526342052,"text":"🖤 Forbidden Flame 🖤\u003cbr /\u003e\u003cbr /\u003eMagnus was exiled to the Forbidden Sector where he became a ruler of sorts. All he longs for revenge. When he finds Amora, all bets are off. Amora is an omega with a \"gift\". She is constantly getting passed around from Alpha to Alpha. I loved her sass as well as her desire to not harm anyone.\u003cbr /\u003e\u003cbr /\u003e✮🖤✮ Favorite quotes ✮🖤✮\u003cbr /\u003e\u003cbr /\u003e\"The joy and comfort, the ecstasy and sense of connection, is more beautiful than anything I could ever have imagined was possible.\"\u003cbr /\u003e\u003cbr /\u003e\"The male was truly a master at overwhelming her senses and making her burn.\"\u003cbr /\u003e\u003cbr /\u003e🖤 Princess Claimed 🖤\u003cbr /\u003e\u003cbr /\u003ePavel was exiled to the Forbidden Sector. He's happy where he's at with the few \"friends\" he has. He doesn't need anything else. Until a princess falls from the sky... literally. I loved Pavel and Ari together! Ari has so much sass and I loved that even though she was Omega, she definitely made her Alpha work for it!\u003cbr /\u003e\u003cbr /\u003e✮🖤✮ Favorite quotes ✮🖤✮\u003cbr /\u003e\u003cbr /\u003e“I’ve shown you mine. Now, since you know I can handle it, show me what you got, convict.”\u003cbr /\u003e\u003cbr /\u003e“I intended to spend the rest of the rotation worshipping you as you deserve.”\u003cbr /\u003e\u003cbr /\u003e🖤 War Prize of the Beast 🖤\u003cbr /\u003e\u003cbr /\u003eI loved this story of how Cheim \u0026amp; Anara go from Hunter and prey to Alpha and Omega! Cheim has only ever known hunting and killing and it was so sweet when he realized that Anara was his. Anara was so patient with Cheim and taught him happiness.\u003cbr /\u003e\u003cbr /\u003e✮🖤✮ Favorite quotes ✮🖤✮\u003cbr /\u003e\u003cbr /\u003e\"Yes good little prey.\"\u003cbr /\u003e\u003cbr /\u003e\"Mine to leash no matter how high you soar.\"\u003cbr /\u003e\u003cbr /\u003e✮🎧✮ Audiobook Review ✮🎧✮\u003cbr /\u003e\u003cbr /\u003eJ.F. Harding \u0026amp; Samantha Brentmoore we're awesome for all three of the stories in this box set! They made the characters come to life and I loved how their voices sounded so different from each story! From sweet and innocent to growly and demanding. This duo was great!","rating":5,"preReleaseBookSource":null,"shelving":{"__ref":"Shelving:{\"creator\":{\"id\":\"kca://profile:goodreads/A106SE6MCCNOJQ\"},\"book\":{\"id\":\"kca://book/amzn1.gr.book.v3.GCrlj0liGt4XSEGK\"}}"},"likeCount":0,"viewerHasLiked":null,"commentCount":0},"User:37938776":{"__typename":"User","legacyId":37938776,"imageUrlSquare":"","isAuthor":false,"viewerRelationshipStatus":null,"followersCount":18,"textReviewsCount":3147,"name":"Kathi","webUrl":"https://www.goodreads.com/user/show/37938776-kathi","contributor":null,"id":37938776},"User:kca://profile:goodreads/A1KNOFGIPBQHX7":{"__typename":"User","id":"kca://profile:goodreads/A1KNOFGIPBQHX7"},"Shelving:{\"creator\":{\"id\":\"kca://profile:goodreads/A1KNOFGIPBQHX7\"},\"book\":{\"id\":\"kca://book/amzn1.gr.book.v3.GCrlj0liGt4XSEGK\"}}":{"__typename":"Shelving","creator":{"__ref":"User:kca://profile:goodreads/A1KNOFGIPBQHX7","id":"kca://profile:goodreads/A1KNOFGIPBQHX7"},"book":{"__ref":"Book:kca://book/amzn1.gr.book.v3.GCrlj0liGt4XSEGK","id":"kca://book/amzn1.gr.book.v3.GCrlj0liGt4XSEGK"},"shelf":{"__typename":"Shelf","name":"read","displayName":"Read","editable":false,"default":true,"actionType":"add_to_read","sortOrder":2,"webUrl":"https://www.goodreads.com/review/list/37938776?shelf=read"},"taggings":[],"webUrl":"https://www.goodreads.com/review/show/5554800625"},"Review:kca://review:goodreads/amzn1.gr.review:goodreads.v2.2023051619.7afb03fe-76cc-4311-ab6c-573609aa5578":{"__typename":"Review","id":"kca://review:goodreads/amzn1.gr.review:goodreads.v2.2023051619.7afb03fe-76cc-4311-ab6c-573609aa5578","creator":{"__ref":"User:37938776"},"recommendFor":null,"updatedAt":1684265923795,"created