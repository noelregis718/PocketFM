ronę.\u003cbr /\u003eI kurde pradawny bóg serio przeklina? I to słowem typu „kurwa”, albo mówi do głównej bohaterki „Ty głupia cipo”? Serio? Istota z głębin używa takich określeń? To mnie wybijało całkiem z tego klimatu. \u003cbr /\u003e\u003cbr /\u003eTrochę szkoda, że cała ta trylogia polega na jednym wydarzeniu i wszystkie książki dzieją się w tym samym czasie. Brakuje trochę tego elementu zaskoczenia, bo znam już przebieg wydarzeń. \u003cbr /\u003eNa szczęście ta część pokrywała się najmniej wydarzeniami z poprzednimi. \u003cbr /\u003e\u003cbr /\u003eOgólnie podobało mi się, ale przez te małe mankamenty nie jestem w stanie dać wyższej oceny. \u003cbr /\u003eChyba nadal 1 część zajmuje podium przez to jak dobrze się czytało na świeżo, ale relacją wygrywa chyba ta.","rating":3,"preReleaseBookSource":null,"shelving":{"__ref":"Shelving:{\"creator\":{\"id\":\"kca://profile:goodreads/A2KY7SJ92VJMPD\"},\"book\":{\"id\":\"kca://book/amzn1.gr.book.v3.qhoMcxgLwe1bZvNm\"}}"},"likeCount":36,"viewerHasLiked":null,"commentCount":0},"User:132836636":{"__typename":"User","legacyId":132836636,"imageUrlSquare":"https://i.gr-assets.com/images/S/compressed.photo.goodreads.com/users/1704054955i/132836636._UY200_CR0,0,200,200_.jpg","isAuthor":false,"viewerRelationshipStatus":null,"followersCount":801,"textReviewsCount":247,"name":"Fia","webUrl":"https://www.goodreads.com/user/show/132836636-fia","contributor":null,"id":132836636},"User:kca://profile:goodreads/A2CFPZOD9K607W":{"__typename":"User","id":"kca://profile:goodreads/A2CFPZOD9K607W"},"Shelving:{\"creator\":{\"id\":\"kca://profile:goodreads/A2CFPZOD9K607W\"},\"book\":{\"id\":\"kca://book/amzn1.gr.book.v3.xGzgQB5fkrWMYEan\"}}":{"__typename":"Shelving","creator":{"__ref":"User:kca://profile:goodreads/A2CFPZOD9K607W","id":"kca://profile:goodreads/A2CFPZOD9K607W"},"book":{"__ref":"Book:kca://book/amzn1.gr.book.v3.xGzgQB5fkrWMYEan","id":"kca://book/amzn1.gr.book.v3.xGzgQB5fkrWMYEan"},"shelf":{"__typename":"Shelf","name":"read","dis