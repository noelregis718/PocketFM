as who he had the sights of his rifle trained on.\u003cbr /\u003e\u003cbr /\u003eRead this tongue in cheek story that will have you anticipating and cheering Cruz and Jody on, had me on the edge of my seat all through the story. I love how scorching hot this tiger is, man do I love feline shifters, they are so passionate! Get those hoses out as you get ready for Cruz.\u003cbr /\u003e\u003cbr /\u003eI can't wait to read the next book in this fantastic series.","rating":5,"preReleaseBookSource":null,"shelving":{"__ref":"Shelving:{\"creator\":{\"id\":\"kca://profile:goodreads/A35V0KOPM959R8\"},\"book\":{\"id\":\"kca://book/amzn1.gr.book.v1.maw-alnR7rBOCGiSrrAeDA\"}}"},"likeCount":2,"viewerHasLiked":null,"commentCount":2},"User:7583206":{"__typename":"User","legacyId":7583206,"imageUrlSquare":"https://i.gr-assets.com/images/S/compressed.photo.goodreads.com/users/1727783685i/7583206._UY200_CR20,0,200,200_.jpg","isAuthor":false,"viewerRelationshipStatus":null,"followersCount":30,"textReviewsCount":2176,"name":"Sarah","webUrl":"https://www.goodreads.com/user/show/7583206-sarah","contributor":null,"id":7583206},"User:kca://profile:goodreads/A17D0E2SYHCOW5":{"__typename":"User","id":"kca://profile:goodreads/A17D0E2SYHCOW5"},"Shelving:{\"creator\":{\"id\":\"kca://profile:goodreads/A17D0E2SYHCOW5\"},\"book\":{\"id\":\"kca://book/amzn1.gr.book.v1.maw-alnR7rBOCGiSrrAeDA\"}}":{"__typename":"Shelving","creator":{"__ref":"User:kca://profile:goodreads/A17D0E2SYHCOW5","id":"kca://profile:goodreads/A17D0E2SYHCOW5"},"book":{"__ref":"Book:kca://book/amzn1.gr.book.v1.maw-alnR7rBOCGiSrrAeDA","id":"kca://book/amzn1.gr.book.v1.maw-alnR7rBOCGiSrrAeDA"},"shelf":{"__typename":"Shelf","name":"read","displayName":"Read","editable":false,"default":true,"actionType":"add_to_read","sortOrder":2,"webUrl":"https://www.goodreads.com/review/list/7583206?shelf=read"},"taggings":[],"webUrl":"https://www.goodreads.com/review/show/3044105421"},"Review:kca://review:goodreads/amzn1.gr.review:goodreads.v1.EeL