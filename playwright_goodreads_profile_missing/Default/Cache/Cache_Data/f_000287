ssets.com/images/S/compressed.photo.goodreads.com/users/1755296595i/62792949._UX200_CR0,33,200,200_.jpg","isAuthor":false,"viewerRelationshipStatus":null,"followersCount":59,"textReviewsCount":1543,"name":"Maddy Max","webUrl":"https://www.goodreads.com/user/show/62792949-maddy-max","contributor":null,"id":62792949},"User:kca://profile:goodreads/A1348M5H1ZMLRI":{"__typename":"User","id":"kca://profile:goodreads/A1348M5H1ZMLRI"},"Shelving:{\"creator\":{\"id\":\"kca://profile:goodreads/A1348M5H1ZMLRI\"},\"book\":{\"id\":\"kca://book/amzn1.gr.book.v1.ijrwwF0t-PmPP3VDum7m0w\"}}":{"__typename":"Shelving","creator":{"__ref":"User:kca://profile:goodreads/A1348M5H1ZMLRI","id":"kca://profile:goodreads/A1348M5H1ZMLRI"},"book":{"__ref":"Book:kca://book/amzn1.gr.book.v1.ijrwwF0t-PmPP3VDum7m0w","id":"kca://book/amzn1.gr.book.v1.ijrwwF0t-PmPP3VDum7m0w"},"shelf":{"__typename":"Shelf","name":"read","displayName":"Read","editable":false,"default":true,"actionType":"add_to_read","sortOrder":2,"webUrl":"https://www.goodreads.com/review/list/62792949?shelf=read"},"taggings":[{"__typename":"Tagging","tag":{"__typename":"Tag","name":"new-adult-or-adult","webUrl":"https://www.goodreads.com/review/list/62792949?shelf=new-adult-or-adult"}},{"__typename":"Tagging","tag":{"__typename":"Tag","name":"most-anticipated-books-of-2020","webUrl":"https://www.goodreads.com/review/list/62792949?shelf=most-anticipated-books-of-2020"}},{"__typename":"Tagging","tag":{"__typename":"Tag","name":"5-stars","webUrl":"https://www.goodreads.com/review/list/62792949?shelf=5-stars"}}],"webUrl":"https://www.goodreads.com/review/show/3009183038"},"Review:kca://review:goodreads/amzn1.gr.review:goodreads.v1.0fGYGcNhdiURLSyJtnG5Ow":{"__typename":"Review","id":"kca://review:goodreads/amzn1.gr.review:goodreads.v1.0fGYGcNhdiURLSyJtnG5Ow","creator":{"__ref":"User:62792949"},"recommendFor":null,"updatedAt":1629065459817,"createdAt":1572099234508,"spoilerStatus":false,"lastRevisionAt":1582906153828,"text":"I feel like I've waited for The Traitor Queen for years instead of months. Also, I currently feel half-dead and can't quite believe that Lara and Aren's story is over. I adore Danielle L. Jensen as a person (she's awesome) and after months wondering if she was going to break my heart, I finally have the answer to that question: yes. She broke it a few times over the course of 66 chapters and every time it was totally worth it.\u003cbr /\u003e\u003cbr /\u003eThe Traitor Queen was action-packed, and Danielle L. Jensen played with my sanity, she scared me to death countless times, and simply made me feel way too much. It's pretty simple actually: it was perfect. And I'm going to miss the hell out of Aren and Lara. These two stole my (shattered) heart and I couldn't have loved them more - even if I tried. \u003cbr /\u003e\u003cbr /\u003eBut my love for The Traitor Queen isn't reduced to Lara and Aren (and how, may I repeat, Danielle scared the crap out of me). She imagined a world that I completely fell in love with and secondary characters that I want to see again asap. There's a lot of potential for future stories in said world, with said characters and I can only hope that I won't die of impatience. \u003cbr /\u003eBut until then, let me tell you how I adored Lara's sisters. They were even more badass than I expected them to be. And Sahrina? I won't say much because I don't want to spoil anyone (who might read this) but \u003cu\u003eshe's my queen.\u003c/u\u003e\u003cbr /\u003eAnd Keris... damn that man is hot and smart and I need more of him. So much more. Same for Zarrah because she was such an interesting character!\u003cbr /\u003e\u003cbr /\u003e\u003cinput type=\"checkbox\" class=\"spoiler__control\" aria-label=\"The following text has been marked spoiler. Toggle checkbox to reveal or hide.\" onchange=\"this.labels[0].setAttribute('aria-hidden', !this.checked);\" id=\"c0636304-83aa-4814-84c3-9d8acfbdaaa5\" /\u003e\u003clabel aria-hidden=\"true\" class=\"spoiler\" for=\"c0636304-83aa-4814-84c3-9d8acfbdaaa5\"\u003eTaryn isn't dead! yay!!\u003c/label\u003e\u003cbr /\u003e\u003cbr /\u003eI could go on and on for a long time but just know that \u003cb\u003ethis was absolutely amazing and I'm already feeling nostalgic\u003c/b\u003e. I'm a thankful mess. \u003cbr /\u003e\u003cbr /\u003eBefore reading/\u003cbr /\u003eYou know what? F*ck it, I'm going to build that time machine \u003ci\u003emyself\u003c/i\u003e.","rating":5,"preReleaseBookSource":null,"shelving":{"__ref":"Shelving:{\"creator\":{\"id\":\"kca://profile:goodreads/A1348M5H1ZMLRI\"},\"book\":{\"id\":\"kca://book/amzn1.gr.book.v1.ijrwwF0t-PmPP3VDum7m0w\"}}"},"likeCount":64,"viewerHasLiked":null,"commentCount":3},"User:108381770":{"__typename":"User","legacyId":108381770,"imageUrlSquare":"","isAuthor":false,"viewerRelationshipStatus":null,"followersCount":200,"textReviewsCount":274,"name":"Katherine","webUrl":"https://www.goodreads.com/user/show/108381770-katherine","contributor":null,"id":108381770},"User:kca://profile:goodreads/A2VJZDUAP7DCK8":{"__typename":"User","id":"kca://profile:goodreads/A2VJZDUAP7DCK8"},"Shelving:{\"creator\":{\"id\":\"kca://profile:goodreads/A2VJZDUAP7DCK8\"},\"book\":{\"id\":\"kca://book/amzn1.gr.book.v3._XDuPlgFa9gIv0Sv\"}}":{"__typename":"Shelving","creator":{"__ref":"User:kca://profile:goodreads/A2VJZDUAP7DCK8","id":"kca://profile:goodreads/A2VJZDUAP7DCK8"},"book":{"__ref":"Book:kca://book/amzn1.gr.book.v3._XDuPlgFa9gIv0Sv","id":"kca://book/amzn1.gr.book.v3._XDuPlgFa9gIv0Sv"},"shelf":{"__typename":"Shelf","name":"read","displayName":"Read","editable":false,"default":true,"actionType":"add_to_read","sortOrder":2,"webUrl":"https://www.goodreads.com/review/list/108381770?shelf=read"},"taggings":[{"__typename":"Tagging","tag":{"__typename":"Tag","name":"2020-favorites","webUrl":"https://www.goodreads.com/review/list/108381770?shelf=2020-favorites"}}],"webUrl":"https://www.goodreads.com/review/show/3569957813"},"Review:kca://review:goodreads/amzn1.gr.review:goodre