 makes H jealous when she is touching one of the customers. \u003cbr /\u003e🟦 OW: Not really either. Some of the other dancers are past lovers of H and try to make h jealous, but they only have eyes for each other. \u003cbr /\u003e🟦 HEA\u003cbr /\u003e","rating":3,"preReleaseBookSource":null,"shelving":{"__ref":"Shelving:{\"creator\":{\"id\":\"kca://profile:goodreads/A20V6WDCNHM6AT\"},\"book\":{\"id\":\"kca://book/amzn1.gr.book.v3.v5Cx7ny_ftBSpEzf\"}}"},"likeCount":6,"viewerHasLiked":null,"commentCount":0},"User:15992420":{"__typename":"User","legacyId":15992420,"imageUrlSquare":"https://i.gr-assets.com/images/S/compressed.photo.goodreads.com/users/1649171835i/15992420._UX200_CR0,33,200,200_.jpg","isAuthor":false,"viewerRelationshipStatus":null,"followersCount":277,"textReviewsCount":2631,"name":"Stacie","webUrl":"https://www.goodreads.com/user/show/15992420-stacie","contributor":null,"id":15992420},"User:kca://profile:goodreads/A2Q3I3Z3VSCCH1":{"__typename":"User","id":"kca://profile:goodreads/A2Q3I3Z3VSCCH1"},"Shelving:{\"creator\":{\"id\":\"kca://profile:goodreads/A2Q3I3Z3VSCCH1\"},\"book\":{\"id\":\"kca://book/amzn1.gr.book.v3.v5Cx7ny_ftBSpEzf\"}}":{"__typename":"Shelving","creator":{"__ref":"User:kca://profile:goodreads/A2Q3I3Z3VSCCH1","id":"kca://profile:goodreads/A2Q3I3Z3VSCCH1"},"book":{"__ref":"Book:kca://book/amzn1.gr.book.v3.v5Cx7ny_ftBSpEzf","id":"kca://book/amzn1.gr.book.v3.v5Cx7ny_ftBSpEzf"},"shelf":{"__typename":"Shelf","name":"read","displayName":"Read","editable":false,"default":true,"actionType":"add_to_read","sortOrder":2,"webUrl":"https://www.goodreads.com/review/list/15992420?shelf=read"},"taggings":[{"__typename":"Tagging","tag":{"__typename":"Tag","name":"aliens","webUrl":"https://www.goodreads.com/review/list/15992420?shelf=aliens"}},{"__typename":"Tagging","tag":{"__typename":"Tag","name":"short-story-collection","webUrl":"https://www.goodreads.com/review/list/15992420?shelf=short-story-collection"}},{"__typename":"Tagging","tag":{"__typenam